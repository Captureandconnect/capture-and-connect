# Hashed bundles — content-addressed, immutable, cache forever
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts — stable filename, safe to cache long
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images — versioned via filename, but allow some flexibility
/images/*
  Cache-Control: public, max-age=2592000

# Videos
/videos/*
  Cache-Control: public, max-age=2592000

# OG images — moderate cache
/og-*
  Cache-Control: public, max-age=86400

# Favicon and touch icon
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400

# HTML — always revalidate so deploys are visible immediately + security headers
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; font-src 'self'; img-src 'self' data: https:; media-src 'self' https:; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://www.instagram.com; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Cross-Origin-Opener-Policy: same-origin

---
const navLinks = [
  { id: '01', label: 'Index',     href: '/' },
  { id: '02', label: 'Services',  href: '/services' },
  { id: '03', label: 'Portfolio', href: '/portfolio' },
  { id: '04', label: 'Results',   href: '/results' },
  { id: '05', label: 'Pricing',   href: '/pricing' },
  { id: '06', label: 'About',     href: '/about' },
  { id: '07', label: 'Contact',   href: '/contact' },
];

const currentPath = Astro.url.pathname;
---

<header
  id="site-nav"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 ease-in-out"
>
  <div class="w-full px-8 md:px-14 lg:px-20">
    <div class="flex items-center justify-between h-16 lg:h-20">

      <!-- Logo + live dot — full 44px tap target on mobile -->
      <a
        href="/"
        class="flex items-center gap-3 group min-h-[44px] -my-2 py-2 -ml-2 pl-2 pr-3"
        data-event="nav_logo"
        aria-label="Capture and Connect — Home"
      >
        <div class="relative w-2 h-2 bg-white rounded-full" aria-hidden="true">
          <div class="absolute inset-0 bg-white rounded-full animate-ping opacity-30"></div>
        </div>
        <span class="font-mono text-[12px] lg:text-[11px] font-bold text-white tracking-[0.2em] uppercase">
          Capture&amp;Connect
        </span>
      </a>

      <!-- Desktop nav links -->
      <nav class="hidden lg:flex items-center gap-10" aria-label="Main navigation">
        {navLinks.map((link) => {
          const isActive =
            link.href === '/'
              ? currentPath === '/'
              : currentPath.startsWith(link.href);
          return (
            <a
              href={link.href}
              class:list={[
                'group/link relative flex items-baseline gap-2 font-mono text-[11px] uppercase tracking-[0.2em] transition-colors duration-300',
                isActive ? 'text-white' : 'text-white/55 hover:text-white',
              ]}
              data-event={`nav_${link.label.toLowerCase()}`}
            >
              <span class="text-[10px] text-white/25 group-hover/link:text-white/60 transition-colors" aria-hidden="true">
                {link.id}
              </span>
              <span>{link.label}</span>
            </a>
          );
        })}
      </nav>

      <!-- Mobile hamburger — 44×44 tap target (WCAG 2.5.5) -->
      <button
        id="nav-hamburger"
        class="hamburger lg:hidden relative flex flex-col items-center justify-center w-11 h-11 -mr-2"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        type="button"
      >
        <span class="hamburger-line hamburger-line--top"></span>
        <span class="hamburger-line hamburger-line--mid"></span>
        <span class="hamburger-line hamburger-line--bot"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile full-screen overlay menu -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-40 bg-[#020202] flex flex-col opacity-0 pointer-events-none transition-opacity duration-300"
  aria-hidden="true"
  inert
>
  <div class="flex-1 flex flex-col justify-center px-8 gap-2">
    {navLinks.map((link, i) => {
      const isActive =
        link.href === '/'
          ? currentPath === '/'
          : currentPath.startsWith(link.href);
      return (
        <a
          href={link.href}
          class:list={[
            'mobile-nav-link flex items-baseline gap-4 py-3 border-b border-white/5 translate-y-4 opacity-0',
            isActive ? 'text-white' : 'text-white/60 hover:text-white',
          ]}
          style={`--delay: ${i * 60}ms`}
          data-event={`nav_${link.label.toLowerCase()}`}
        >
          <span class="font-mono text-[10px] tracking-widest text-white/55">{link.id}</span>
          <span class="text-3xl font-black italic uppercase tracking-tighter">
            {link.label}
          </span>
        </a>
      );
    })}
  </div>
  <div class="px-8 pb-12 pt-6 border-t border-white/5 flex flex-col gap-5">
    <a
      href="mailto:info@captureandconnect.nl"
      class="mobile-nav-link inline-flex items-center gap-4 group/cta translate-y-4 opacity-0"
      style={`--delay: ${navLinks.length * 60}ms`}
      data-event="nav_book_call"
      data-event-location="mobile_menu"
    >
      <span class="w-12 h-12 rounded-full border border-white/15 flex items-center justify-center group-hover/cta:bg-white transition-all duration-500">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="group-hover/cta:stroke-black stroke-white transition-colors duration-500">
          <path d="M7 17L17 7M17 7H8M17 7V16" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="font-mono text-[11px] font-bold text-white uppercase tracking-[0.2em]">
        Get in Touch
      </span>
    </a>
    <a
      href="https://www.instagram.com/captureandconnect_"
      data-ig-deeplink="instagram://user?username=captureandconnect_"
      target="_blank"
      rel="noopener noreferrer"
      class="mobile-nav-link inline-flex items-center gap-4 group/dm translate-y-4 opacity-0"
      style={`--delay: ${(navLinks.length + 1) * 60}ms`}
      data-event="social_instagram"
      data-event-location="mobile_menu"
    >
      <span class="w-12 h-12 rounded-full border border-white/15 flex items-center justify-center group-hover/dm:bg-white transition-all duration-500">
        <!-- Instagram glyph -->
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="group-hover/dm:stroke-black stroke-white transition-colors duration-500" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <circle cx="12" cy="12" r="4"/>
          <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
        </svg>
      </span>
      <span class="font-mono text-[11px] font-bold text-white uppercase tracking-[0.2em]">
        DM on Instagram
      </span>
    </a>
  </div>
</div>

<style>
  header {
    background: linear-gradient(to bottom, rgb(2 2 2 / 0.85) 0%, rgb(2 2 2 / 0.6) 70%, rgb(2 2 2 / 0) 100%);
  }
  header.scrolled {
    background: rgb(2 2 2 / 0.92);
    backdrop-filter: blur(24px) saturate(140%);
    -webkit-backdrop-filter: blur(24px) saturate(140%);
    border-bottom: 1px solid rgb(255 255 255 / 0.05);
  }

  .hamburger {
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    -webkit-tap-highlight-color: transparent;
  }
  .hamburger-line {
    display: block;
    width: 22px;
    height: 1px;
    background-color: #fff;
    transition: transform 0.3s ease, opacity 0.3s ease, width 0.3s ease;
    position: absolute;
  }
  .hamburger-line--top { transform: translateY(-6px); }
  .hamburger-line--bot { width: 14px; transform: translateY(6px); }
  .hamburger.active .hamburger-line--top { transform: rotate(45deg); }
  .hamburger.active .hamburger-line--mid { opacity: 0; }
  .hamburger.active .hamburger-line--bot { width: 22px; transform: rotate(-45deg); }

  @media (prefers-reduced-motion: no-preference) {
    #mobile-menu.open .mobile-nav-link {
      animation: slideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      animation-delay: var(--delay, 0ms);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #mobile-menu.open .mobile-nav-link {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes slideUp {
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  const header = document.getElementById('site-nav') as HTMLElement;
  const hamburger = document.getElementById('nav-hamburger') as HTMLButtonElement;
  const mobileMenu = document.getElementById('mobile-menu') as HTMLElement;

  const handleScroll = () => {
    if (window.scrollY > 4) header.classList.add('scrolled');
    else header.classList.remove('scrolled');
  };
  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();

  let menuOpen = false;
  const openMenu = () => {
    menuOpen = true;
    hamburger.classList.add('active');
    mobileMenu.classList.remove('opacity-0', 'pointer-events-none');
    mobileMenu.classList.add('open', 'opacity-100');
    mobileMenu.setAttribute('aria-hidden', 'false');
    mobileMenu.removeAttribute('inert');
    hamburger.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  };
  const closeMenu = () => {
    menuOpen = false;
    hamburger.classList.remove('active');
    mobileMenu.classList.add('opacity-0', 'pointer-events-none');
    mobileMenu.classList.remove('open', 'opacity-100');
    mobileMenu.setAttribute('aria-hidden', 'true');
    mobileMenu.setAttribute('inert', '');
    hamburger.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  };
  hamburger.addEventListener('click', () => menuOpen ? closeMenu() : openMenu());
  mobileMenu.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menuOpen) closeMenu(); });
</script>

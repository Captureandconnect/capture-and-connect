---
// StickyMobileCta.astro — visible only below 768px, appears after 300px scroll.
// Hidden on /contact (the destination) via the data-no-cta attribute on <body>.
const isContactPage = Astro.url.pathname.startsWith('/contact');
---

{!isContactPage && (
  <div
    id="cnc-mobile-cta"
    class="cnc-mobile-cta"
    role="complementary"
    aria-label="Quick contact options"
  >
    <a
      href="https://www.instagram.com/captureandconnect_"
      data-ig-deeplink="instagram://user?username=captureandconnect_"
      target="_blank"
      rel="noopener noreferrer"
      class="cnc-mobile-cta__dm"
      aria-label="DM us on Instagram"
      data-event="social_instagram_dm"
      data-event-location="mobile_sticky"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
        <circle cx="12" cy="12" r="4"/>
        <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
      </svg>
      <span class="cnc-mobile-cta__dm-label">DM</span>
    </a>
    <span class="cnc-mobile-cta__divider" aria-hidden="true"></span>
    <a
      href="/contact"
      class="cnc-mobile-cta__book"
      aria-label="Book a free growth call"
      data-event="cta_book_call"
      data-event-location="mobile_sticky"
    >
      <span class="cnc-mobile-cta__book-text">Book Free Call</span>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7 17L17 7M17 7H8M17 7V16" />
      </svg>
    </a>
  </div>
)}

<script is:inline>
  (() => {
    const cta = document.getElementById('cnc-mobile-cta');
    if (!cta) return;
    const onScroll = () => {
      if (window.scrollY > 300) cta.setAttribute('data-visible', '1');
      else cta.removeAttribute('data-visible');
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>

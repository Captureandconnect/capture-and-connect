---
const navLinks = [
  { id: '01', label: 'Index',     href: '/' },
  { id: '02', label: 'Services',  href: '/services' },
  { id: '03', label: 'Portfolio', href: '/portfolio' },
  { id: '04', label: 'Results',   href: '/results' },
  { id: '05', label: 'Pricing',   href: '/pricing' },
  { id: '06', label: 'About',     href: '/about' },
  { id: '07', label: 'Contact',   href: '/contact' },
];

const year = new Date().getFullYear();
---

<footer class="relative bg-[#020202] border-t border-white/[0.06] overflow-hidden">

  <!-- Massive italic word watermark, mouse-reactive -->
  <div
    id="footer-watermark"
    class="pointer-events-none absolute -bottom-8 left-0 right-0 select-none transition-transform duration-700 ease-out will-change-transform opacity-[0.04]"
    aria-hidden="true"
    role="presentation"
  >
    <span aria-hidden="true" class="block text-[18vw] md:text-[14vw] leading-[0.85] font-black italic uppercase tracking-tighter text-white whitespace-nowrap text-center">
      CAPTURE&amp;CONNECT
    </span>
  </div>

  <div class="relative max-w-[1600px] mx-auto px-6 md:px-10 lg:px-14 pt-20 pb-[max(2.5rem,env(safe-area-inset-bottom))]">

    <!-- Top row: brand + tagline + meta -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-10 mb-16">

      <!-- Brand cell -->
      <div class="md:col-span-5 flex flex-col gap-5">
        <div class="flex items-center gap-3">
          <div class="relative w-2 h-2 bg-white rounded-full">
            <div class="absolute inset-0 bg-white rounded-full animate-ping opacity-30"></div>
          </div>
          <span class="font-mono text-[10px] text-white/50 uppercase tracking-[0.25em]">
            001 // STUDIO
          </span>
        </div>
        <h3 class="text-3xl md:text-4xl font-black italic uppercase tracking-tighter text-white leading-[0.95]">
          From lens<br/>to <span class="text-outline not-italic">likes</span>.
        </h3>
        <p class="text-sm text-white/55 leading-relaxed max-w-xs">
          Content, social media and strategy built to turn attention into views, followers and revenue.
        </p>
      </div>

      <!-- Index links -->
      <div class="md:col-span-3 flex flex-col gap-4">
        <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.25em] mb-2">
          002 // INDEX
        </span>
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="group/foot flex items-baseline gap-3 py-2 font-mono text-[11px] uppercase tracking-[0.2em] text-white/50 hover:text-white transition-colors duration-300"
          >
            <span class="text-[9px] text-white/55 group-hover/foot:text-white transition-colors">{link.id}</span>
            <span>{link.label}</span>
            <span class="ml-auto opacity-0 -translate-x-2 group-hover/foot:opacity-100 group-hover/foot:translate-x-0 transition-all duration-300">→</span>
          </a>
        ))}
      </div>

      <!-- Connect cell -->
      <div class="md:col-span-4 flex flex-col gap-4">
        <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.25em] mb-2">
          003 // CONNECT
        </span>
        <a href="mailto:info@captureandconnect.nl" class="group/c flex items-center gap-3 text-white/60 hover:text-white transition-colors duration-300">
          <span class="font-mono text-[10px] text-white/55 group-hover/c:text-white/60 transition-colors">EMAIL</span>
          <span class="h-px flex-1 bg-white/5 group-hover/c:bg-white/30 transition-colors"></span>
          <span class="font-mono text-[11px] tracking-[0.15em]">info@captureandconnect.nl</span>
        </a>
        <a href="https://www.instagram.com/captureandconnect_" target="_blank" rel="noopener noreferrer" class="group/c flex items-center gap-3 text-white/60 hover:text-white transition-colors duration-300">
          <span class="font-mono text-[10px] text-white/55 group-hover/c:text-white/60 transition-colors">SOCIAL</span>
          <span class="h-px flex-1 bg-white/5 group-hover/c:bg-white/30 transition-colors"></span>
          <span class="font-mono text-[11px] tracking-[0.15em]">@captureandconnect_</span>
        </a>
        <div class="group/c flex items-center gap-3 text-white/60">
          <span class="font-mono text-[10px] text-white/55">LOCAL</span>
          <span class="h-px flex-1 bg-white/5"></span>
          <span class="font-mono text-[11px] tracking-[0.15em]" id="footer-clock">00:00:00 CET</span>
        </div>
        <div class="group/c flex items-center gap-3 text-white/60">
          <span class="font-mono text-[10px] text-white/55">STATUS</span>
          <span class="h-px flex-1 bg-white/5"></span>
          <span class="font-mono text-[11px] tracking-[0.15em] flex items-center gap-2">
            <span class="relative w-1.5 h-1.5 bg-white rounded-full">
              <span class="absolute inset-0 bg-white rounded-full animate-ping opacity-40"></span>
            </span>
            Open for projects · Q3 / Q4
          </span>
        </div>
      </div>
    </div>

    <!-- Legal row -->
    <div class="border-t border-white/[0.06] pt-6 flex flex-wrap items-center gap-x-5 gap-y-2 mb-4">
      <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.2em]">
        KVK <span class="text-white/75">90315790</span>
      </span>
      <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.2em]">
        BTW <span class="text-white/75">NL004804916B78</span>
      </span>
      <a href="/privacy" class="font-mono text-[10px] text-white/55 hover:text-white uppercase tracking-[0.2em] transition-colors py-2 -my-2">
        Privacy
      </a>
    </div>

    <!-- Bottom bar -->
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <p class="font-mono text-[10px] text-white/55 uppercase tracking-[0.2em]">
        © {year} CAPTURE &amp; CONNECT · ALL RIGHTS RESERVED
      </p>
      <p class="font-mono text-[10px] text-white/55 uppercase tracking-[0.2em]">
        Crafted in the Netherlands
      </p>
    </div>
  </div>
</footer>

<script>
  // Live local clock
  const clockEl = document.getElementById('footer-clock');
  if (clockEl) {
    const tick = () => {
      const now = new Date();
      const h = String(now.getHours()).padStart(2, '0');
      const m = String(now.getMinutes()).padStart(2, '0');
      const s = String(now.getSeconds()).padStart(2, '0');
      clockEl.textContent = `${h}:${m}:${s} CET`;
    };
    tick();
    setInterval(tick, 1000);
  }

  // Mouse-reactive watermark drift
  const watermark = document.getElementById('footer-watermark') as HTMLElement | null;
  if (watermark) {
    let x = 0;
    let tx = 0;
    const ease = 0.06;
    const onMove = (e: MouseEvent) => {
      const r = watermark.getBoundingClientRect();
      const inside =
        e.clientY > r.top - 100 &&
        e.clientY < r.bottom + 100;
      if (!inside) return;
      tx = ((e.clientX / window.innerWidth) - 0.5) * 80;
    };
    const loop = () => {
      x += (tx - x) * ease;
      watermark.style.transform = `translate3d(${x}px, 0, 0)`;
      requestAnimationFrame(loop);
    };
    window.addEventListener('mousemove', onMove);
    loop();
  }
</script>

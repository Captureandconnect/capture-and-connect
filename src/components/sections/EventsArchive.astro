---
import { events } from '../../data/events.ts';
---

<div class="events-archive mb-14 md:mb-16">

  <!-- Header strip -->
  <div class="flex items-end justify-between flex-wrap gap-4 mb-6 pb-5 border-b border-white/[0.06]">
    <div class="flex items-baseline gap-4">
      <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.25em]">// Events covered</span>
      <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.2em] hidden md:inline-flex items-center gap-2">
        <span class="w-3 h-px bg-white/20"></span>
        {events.length} festivals
      </span>
    </div>
    <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.2em]">
      Click any tile to reveal artists →
    </span>
  </div>

  <!-- 6-card grid: 3 cols desktop, 2 tablet, 1 mobile -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5 items-start">
    {events.map((ev, i) => {
      const number = String(i + 1).padStart(2, '0');
      return (
        <article
          class="event-card group relative bg-[#0a0a0a] border border-white/[0.06] hover:border-white/25 transition-all duration-500 overflow-hidden"
          data-event-id={ev.id}
        >
          <!-- Top accent line -->
          <span class="absolute top-0 left-0 h-px w-12 bg-white transition-all duration-700 group-hover:w-full z-20" aria-hidden="true"></span>

          <!-- Trigger area: cover + meta -->
          <button
            type="button"
            class="event-trigger w-full text-left block"
            aria-expanded="false"
          >
            <div class="relative aspect-[4/5] overflow-hidden">
              <img
                src={ev.cover}
                alt={`${ev.name}${ev.edition ? ' · ' + ev.edition : ''}`}
                loading="lazy"
                class="absolute inset-0 w-full h-full object-cover scale-105 group-hover:scale-100 transition-transform duration-1000"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#020202] via-[#020202]/55 to-transparent opacity-95"></div>

              <!-- Top: number + tag -->
              <div class="absolute top-4 left-4 right-4 flex items-start justify-between gap-3 z-10">
                <span class="font-mono text-[10px] text-white/70 uppercase tracking-[0.25em]">
                  {number} // {ev.tag}
                </span>
                <span class="bg-white/10 backdrop-blur-md border border-white/15 text-white text-[10px] font-mono uppercase tracking-[0.15em] px-2.5 py-1 rounded-full inline-flex items-center gap-1.5">
                  <span class="font-bold">{ev.djs.length}</span>
                  <span class="text-white/70">{ev.djs.length === 1 ? 'artist' : 'artists'}</span>
                </span>
              </div>

              <!-- Center: expand indicator on hover -->
              <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none">
                <span class="w-14 h-14 md:w-16 md:h-16 rounded-full bg-white/10 backdrop-blur-md border border-white/30 flex items-center justify-center expand-indicator transition-transform duration-500">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path class="plus-v transition-opacity duration-300" d="M12 5v14"/>
                    <path d="M5 12h14"/>
                  </svg>
                </span>
              </div>

              <!-- Bottom: title + meta -->
              <div class="absolute bottom-0 left-0 right-0 p-5 md:p-6 flex flex-col gap-2">
                <h3 class="text-xl md:text-2xl font-black italic uppercase leading-[1] tracking-tighter text-white">
                  {ev.name}
                </h3>
                {ev.edition && (
                  <span class="font-mono text-[10px] text-white/60 uppercase tracking-[0.2em]">
                    {ev.edition}
                  </span>
                )}
                <div class="flex items-center justify-between pt-1">
                  <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.2em]">
                    {ev.date}
                  </span>
                  <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.2em] flex items-center gap-2 trigger-cta">
                    <span class="cta-text">View artists</span>
                    <span class="w-3 h-px bg-white/40 group-hover:w-8 group-hover:bg-white transition-all duration-500"></span>
                  </span>
                </div>
              </div>
            </div>
          </button>

          <!-- Expanded panel: DJ list -->
          <div
            class="event-panel grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-out"
            data-panel
          >
            <div class="overflow-hidden">
              <div class="border-t border-white/[0.06] p-5 md:p-6 flex flex-col gap-4">
                <div class="flex items-center justify-between">
                  <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.25em]">
                    // Artists filmed
                  </span>
                  <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.2em]">
                    {ev.venue}
                  </span>
                </div>

                {ev.djs.length > 0 ? (
                  <ul class="flex flex-col">
                    {ev.djs.map((dj, j) => {
                      // Split "Artist1 vs Artist2" so both names get equal billing
                      const vsMatch = dj.name.match(/^(.+?)\s+vs\s+(.+)$/i);
                      const primary = vsMatch ? vsMatch[1] : dj.name;
                      const opponent = vsMatch ? vsMatch[2] : null;
                      return (
                      <li>
                        <a
                          href={dj.instagramPost}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="dj-link group/dj flex items-center justify-between gap-3 py-3 border-b border-white/[0.06] last:border-b-0 hover:pl-2 transition-all duration-300"
                        >
                          <div class="flex items-baseline gap-3 min-w-0">
                            <span class="font-mono text-[9px] text-white/55 tracking-[0.2em]">
                              {String(j + 1).padStart(2, '0')}
                            </span>
                            <div class="flex flex-col min-w-0 pr-2 gap-0.5">
                              <span class="text-[15px] md:text-base font-black italic uppercase tracking-tight text-white leading-tight break-words">
                                {primary}
                              </span>
                              {opponent && (
                                <span class="text-[13px] md:text-sm font-black italic uppercase tracking-tight text-white/85 leading-tight break-words flex items-baseline gap-2">
                                  <span class="font-mono text-[9px] not-italic text-white/45 tracking-[0.2em]">VS</span>
                                  {opponent}
                                </span>
                              )}
                              {(dj.role || dj.handle) && (
                                <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.2em] mt-0.5">
                                  {dj.role ?? `@${dj.handle}`}
                                </span>
                              )}
                            </div>
                          </div>
                          <span class="shrink-0 inline-flex items-center gap-2 font-mono text-[10px] text-white/50 uppercase tracking-[0.2em] group-hover/dj:text-white transition-colors duration-300">
                            <span>IG</span>
                            <span class="w-7 h-7 rounded-full border border-white/15 flex items-center justify-center group-hover/dj:bg-white transition-all duration-300">
                              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" class="group-hover/dj:stroke-black stroke-white/70 transition-colors duration-300">
                                <path d="M7 17L17 7M17 7H8M17 7V16" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                              </svg>
                            </span>
                          </span>
                        </a>
                      </li>
                      );
                    })}
                  </ul>
                ) : (
                  <div class="py-6 flex flex-col items-center text-center gap-2 border border-dashed border-white/10">
                    <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.25em]">
                      Coverage soon
                    </span>
                    <span class="text-[12px] text-white/55">Artists tagged after release.</span>
                  </div>
                )}
              </div>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</div>

<script>
  const cards = document.querySelectorAll<HTMLElement>('.event-card');

  cards.forEach((card) => {
    const trigger = card.querySelector<HTMLButtonElement>('.event-trigger');
    const panel = card.querySelector<HTMLElement>('[data-panel]');
    const indicator = card.querySelector<HTMLElement>('.expand-indicator');
    const plusVertical = card.querySelector<HTMLElement>('.plus-v');
    const ctaText = card.querySelector<HTMLElement>('.cta-text');
    if (!trigger || !panel) return;

    trigger.addEventListener('click', () => {
      const isOpen = card.classList.toggle('is-open');

      if (isOpen) {
        panel.classList.remove('grid-rows-[0fr]');
        panel.classList.add('grid-rows-[1fr]');
        trigger.setAttribute('aria-expanded', 'true');
        if (indicator) indicator.style.transform = 'rotate(45deg)';
        if (plusVertical) plusVertical.style.opacity = '0';
        if (ctaText) ctaText.textContent = 'Hide artists';
        card.classList.add('border-white/30');
      } else {
        panel.classList.remove('grid-rows-[1fr]');
        panel.classList.add('grid-rows-[0fr]');
        trigger.setAttribute('aria-expanded', 'false');
        if (indicator) indicator.style.transform = '';
        if (plusVertical) plusVertical.style.opacity = '';
        if (ctaText) ctaText.textContent = 'View artists';
        card.classList.remove('border-white/30');
      }
    });
  });
</script>

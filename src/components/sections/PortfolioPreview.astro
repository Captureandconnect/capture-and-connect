---
import { Picture } from 'astro:assets';
import { portfolioItems } from '../../data/portfolio';
import { portfolioImage } from '../../lib/portfolioImages';
import SectionLabel from '../ui/SectionLabel.astro';

// Hard cap at 6 — homepage rule: exactly 6 tiles, always.
const projects = portfolioItems.filter((p) => p.featured).slice(0, 6);
---

<section
  class="relative bg-[#020202] py-20 md:py-24 overflow-hidden border-t border-white/[0.05]"
  aria-labelledby="portfolio-heading"
>

  <!-- Section header -->
  <div class="relative max-w-[1600px] mx-auto px-6 md:px-10 lg:px-14 mb-12 md:mb-14">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-10 items-end">
      <div class="md:col-span-7">
        <SectionLabel n={3} label="Selected work" class="mb-6" />
        <h2
          id="portfolio-heading"
          class="text-[clamp(3rem,8vw,7.5rem)] font-black italic uppercase leading-[0.95] tracking-tighter text-white"
        >
          Selected <br/><span class="text-outline not-italic">work.</span>
        </h2>
      </div>
      <p class="md:col-span-4 md:col-start-9 text-[15px] text-white/50 leading-relaxed">
        Real content. Real results. Recent wins from artists, festivals and brands. Tap any tile to open the live work.
      </p>
    </div>
  </div>

  <!-- Project grid -->
  <div class="relative max-w-[1600px] mx-auto px-6 md:px-10 lg:px-14">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5">
      {projects.map((project, idx) => {
        const number = String(idx + 1).padStart(2, '0');
        const target = project.external ? '_blank' : undefined;
        const rel = project.external ? 'noopener noreferrer' : undefined;
        const displayCategory = project.displayCategory ?? project.category;
        return (
          <a
            href={project.href ?? '/portfolio'}
            target={target}
            rel={rel}
            class="project-cell group relative block overflow-hidden bg-[#0a0a0a] border border-white/[0.06] hover:border-white/25 transition-all duration-700"
          >
            <!-- Top accent line -->
            <span class="absolute top-0 left-0 h-px w-12 bg-white transition-all duration-700 group-hover:w-full z-20" aria-hidden="true"></span>

            <!-- Image -->
            <div class="relative aspect-[4/5] overflow-hidden">
              <Picture
                src={portfolioImage(project.thumbnail)}
                alt={`${project.title} — ${displayCategory} content by Capture & Connect`}
                widths={[400, 600, 800, 1200]}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                loading={idx === 0 ? 'eager' : 'lazy'}
                {...(idx === 0 ? { fetchpriority: 'high' } : {})}
                decoding="async"
                formats={['avif', 'webp']}
                class:list={[
                  'absolute inset-0 w-full h-full object-cover transition-transform duration-1000',
                  project.coverStyle === 'design'
                    ? 'object-top scale-100 group-hover:scale-[1.02]'
                    : 'object-center scale-105 group-hover:scale-100',
                ]}
              />
              <!-- Gradient overlay — stronger bottom on design covers for caption legibility -->
              <div
                class:list={[
                  'absolute inset-0',
                  project.coverStyle === 'design'
                    ? 'bg-gradient-to-t from-[#020202] from-30% via-[#020202]/55 to-transparent opacity-95'
                    : 'bg-gradient-to-t from-[#020202] via-[#020202]/60 to-transparent opacity-95',
                ]}
              ></div>

              <!-- Top: number + stats -->
              <div class="absolute top-4 left-4 right-4 flex items-start justify-between gap-3 z-10">
                <span class="font-mono text-[10px] text-white/70 uppercase tracking-[0.25em]">
                  {number} // {displayCategory}
                </span>
                {project.stats && (
                  <span class="bg-white/10 backdrop-blur-md border border-white/15 text-white text-[10px] font-mono uppercase tracking-[0.15em] px-2.5 py-1 rounded-full">
                    {project.stats}
                  </span>
                )}
              </div>

              <!-- External / play indicator center on hover -->
              <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 group-active:opacity-100 transition-opacity duration-500">
                <span class="w-14 h-14 md:w-16 md:h-16 rounded-full bg-white/10 backdrop-blur-md border border-white/30 flex items-center justify-center">
                  {project.external ? (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M7 17L17 7M17 7H8M17 7V16" />
                    </svg>
                  ) : (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="white">
                      <path d="M5 4l14 8-14 8z"/>
                    </svg>
                  )}
                </span>
              </div>

              <!-- Caption -->
              <div class="absolute bottom-0 left-0 right-0 p-5 md:p-6 flex flex-col gap-3">
                <h3 class="text-xl md:text-2xl font-black italic uppercase leading-[1] tracking-tighter text-white">
                  {project.title}
                </h3>
                <div class="flex items-center justify-between">
                  <span class="font-mono text-[10px] text-white/50 uppercase tracking-[0.2em]">
                    {project.external ? 'Open' : 'View'}
                  </span>
                  <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.2em] flex items-center gap-2">
                    <span class="w-3 h-px bg-white/40 group-hover:w-8 group-hover:bg-white transition-all duration-500"></span>
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-white/60 group-hover:text-white transition-colors duration-500">
                      <path d="M7 17L17 7M17 7H8M17 7V16" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </div>
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <!-- View all CTA -->
    <div class="mt-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <p class="font-mono text-[11px] text-white/55 uppercase tracking-[0.2em]">
        // Six wins. Many more in the archive.
      </p>
      <a href="/portfolio/" class="group/cta inline-flex items-center gap-4">
        <span class="w-12 h-12 rounded-full border border-white/15 flex items-center justify-center group-hover/cta:bg-white transition-all duration-500">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="group-hover/cta:stroke-black stroke-white transition-colors duration-500">
            <path d="M7 17L17 7M17 7H8M17 7V16" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="font-mono text-[11px] font-bold text-white uppercase tracking-[0.2em]">
          Browse The Archive
        </span>
      </a>
    </div>
  </div>
</section>

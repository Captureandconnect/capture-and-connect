---
// Every card links to something a visitor can open — that is the promise made
// in the intro paragraph below, so a card without a destination does not belong
// in this grid.
import SectionLabel from '../ui/SectionLabel.astro';

const stats = [
  {
    id: '01',
    target: 125,
    suffix: 'M+',
    label: 'Total reach',
    note: 'Total reach across all content we have produced, including event and festival work.',
    href: '/results/',
    linkLabel: 'See the public sources behind our total reach',
  },
  {
    id: '02',
    target: 250,
    suffix: '+',
    label: 'Events filmed',
    note: 'Across our lifetime. Highlights: Masters Of Hardcore, Rebirth, Reverze, Paaspop, Ground Zero.',
    href: '/portfolio/#content-creation',
    linkLabel: 'Browse the event archive in our portfolio',
  },
  {
    id: '03',
    target: 9,
    suffix: '',
    label: 'Accounts growing',
    note: '6 Instagram, 3 TikTok live right now. Growing every month.',
    href: '/portfolio/#social-media',
    linkLabel: 'See the accounts we manage',
  },
  {
    id: '04',
    target: 2,
    suffix: '',
    label: 'Live websites built',
    note: 'Hairmoment.nl and this site. Both fully custom, both converting.',
    href: '/portfolio/#web-design',
    linkLabel: 'See the websites we have shipped',
  },
];
---

<section
  class="relative bg-[#020202] pt-10 md:pt-12 pb-20 md:pb-24 overflow-hidden border-t border-white/[0.05]"
  aria-labelledby="results-heading"
>

  <!-- Marquee ticker (top) — pure CSS infinite scroll -->
  <div class="relative mb-14 md:mb-16 overflow-hidden border-y border-white/[0.06] py-5">
    <div class="marquee flex whitespace-nowrap items-center gap-12 font-mono text-[11px] uppercase tracking-[0.25em] text-white/55">
      {[...Array(2)].map(() => (
        <div class="flex items-center gap-12 shrink-0">
          <span class="text-white">125M+ TOTAL REACH</span>
          <span>·</span>
          <span>250+ EVENTS FILMED</span>
          <span>·</span>
          <span class="text-white">9 ACCOUNTS GROWING</span>
          <span>·</span>
          <span>BASED IN NL</span>
          <span>·</span>
          <span class="text-white">OPEN FOR PROJECTS</span>
          <span>·</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Section header -->
  <div class="relative max-w-[1600px] mx-auto px-6 md:px-10 lg:px-14 mb-12 md:mb-14">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-10 items-end">
      <div class="md:col-span-7">
        <SectionLabel n={2} label="Results" class="mb-6" />
        <h2
          id="results-heading"
          class="text-[clamp(3rem,8vw,7.5rem)] font-black italic uppercase leading-[0.95] tracking-tighter text-white"
        >
          Numbers don't <br/><span class="text-outline not-italic">lie.</span>
        </h2>
      </div>
      <p class="md:col-span-4 md:col-start-9 text-[15px] text-white/50 leading-relaxed">
        Real numbers. Real growth. Every figure links to something you can open and verify yourself. No projections, no fake metrics.
      </p>
    </div>
  </div>

  <!-- Stat tickers -->
  <div class="relative max-w-[1600px] mx-auto px-6 md:px-10 lg:px-14">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px bg-white/[0.04] border border-white/[0.05]">
      {stats.map((stat) => (
        <a
          href={stat.href}
          aria-label={stat.linkLabel}
          class="stat-cell group relative bg-[#020202] hover:bg-[#070707] transition-colors duration-500 p-8 md:p-10 flex flex-col gap-6 min-h-[260px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-[#020202]"
        >
          <!-- ID label -->
          <div class="flex items-center justify-between">
            <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.25em]">
              {stat.id} // METRIC
            </span>
            <span class="relative w-1.5 h-1.5 rounded-full bg-white">
              <span class="absolute inset-0 rounded-full bg-white animate-ping opacity-30"></span>
            </span>
          </div>

          <!-- Counter — final value is the initial SSR text so a no-JS or
               slow-firing observer never strands users on a "0". -->
          <div class="flex items-baseline gap-1 mt-auto">
            <span
              class="counter text-6xl md:text-7xl lg:text-[5.5rem] font-black italic leading-none tracking-tighter text-white tabular-nums"
              data-target={stat.target}
              data-suffix={stat.suffix}
            >{stat.target}</span>
            <span class="text-3xl md:text-4xl font-black italic text-white/55 tracking-tighter">{stat.suffix}</span>
          </div>

          <!-- Label + note -->
          <div class="flex flex-col gap-2">
            <span class="font-mono text-[11px] text-white uppercase tracking-[0.2em]">{stat.label}</span>
            <p class="text-[12px] text-white/55 leading-relaxed">{stat.note}</p>
          </div>

          <!-- Bottom hairline grows on hover -->
          <span class="absolute bottom-0 left-0 h-px w-0 bg-white group-hover:w-full transition-all duration-700"></span>
        </a>
      ))}
    </div>

    <!-- Footer row -->
    <div class="mt-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <p class="font-mono text-[11px] text-white/55 uppercase tracking-[0.2em] max-w-md">
        Real numbers. Public sources. Verify the work yourself.
      </p>
      <a href="/results" class="group/cta inline-flex items-center gap-4">
        <span class="w-12 h-12 rounded-full border border-white/15 flex items-center justify-center group-hover/cta:bg-white transition-all duration-500">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="group-hover/cta:stroke-black stroke-white transition-colors duration-500">
            <path d="M7 17L17 7M17 7H8M17 7V16" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="font-mono text-[11px] font-bold text-white uppercase tracking-[0.2em]">
          See The Proof
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .marquee {
    animation: marquee 50s linear infinite;
  }
  @keyframes marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      animation: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  // Counter animation. Final value is the SSR/initial text content (set in the
  // template) — so even if the script never runs or the IO never fires, the
  // user sees the correct number. We only animate when the element is below
  // the fold AND prefers-reduced-motion is not set.
  const counters = document.querySelectorAll<HTMLElement>('.counter');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduced) {
    counters.forEach((el) => {
      const rect = el.getBoundingClientRect();
      const alreadyVisible = rect.top < window.innerHeight && rect.bottom > 0;
      if (alreadyVisible) {
        el.dataset.done = '1';
        return; // SSR text is already on screen — don't reset to 0.
      }
      // Below the fold — safe to reset to 0 so the count-up animation reads.
      el.textContent = '0';
    });
  }

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      const el = entry.target as HTMLElement;
      if (el.dataset.done === '1') return;
      el.dataset.done = '1';
      const target = Number(el.dataset.target ?? 0);
      const duration = 1800;
      const start = performance.now();
      const ease = (t: number) => 1 - Math.pow(1 - t, 4);
      const isFloat = !Number.isInteger(target);
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        const v = ease(t) * target;
        el.textContent = isFloat ? v.toFixed(1) : String(Math.floor(v));
        if (t < 1) requestAnimationFrame(tick);
        else el.textContent = isFloat ? target.toFixed(1) : String(target);
      };
      requestAnimationFrame(tick);
    });
  }, { threshold: 0.4 });
  counters.forEach((c) => observer.observe(c));
</script>

---
interface Props {
  headline?: string;
  subtext?: string;
  buttonText?: string;
  buttonHref?: string;
  secondaryLinkText?: string;
  secondaryLinkHref?: string;
}

const {
  headline = 'Ready to grow?',
  subtext = "Stop blending in. Let's build content that makes your brand impossible to ignore.",
  buttonText = 'Start a project',
  buttonHref = 'mailto:info@captureandconnect.nl',
  secondaryLinkText,
  secondaryLinkHref,
} = Astro.props;
---

<section class="relative bg-[#020202] py-20 md:py-24 overflow-hidden border-t border-white/[0.05]">

  <!-- Mouse-reactive watermark, smaller so it doesn't bloat the section -->
  <div
    id="cta-watermark"
    class="pointer-events-none absolute inset-x-0 bottom-0 flex items-end justify-center select-none transition-transform duration-700 ease-out will-change-transform"
    aria-hidden="true"
  >
    <span aria-hidden="true" class="block text-[18vw] md:text-[12vw] leading-[0.8] font-black italic uppercase tracking-tighter text-white/[0.04] whitespace-nowrap translate-y-[18%]">
      LET&rsquo;S TALK
    </span>
  </div>

  <div class="relative max-w-[1600px] mx-auto px-6 md:px-10 lg:px-14 grid grid-cols-1 md:grid-cols-12 gap-10 items-center">

    <div class="md:col-span-7 flex flex-col gap-8">
      <span class="font-mono text-[11px] text-white/55 uppercase tracking-[0.25em] flex items-center gap-3">
        <span class="relative w-2 h-2 bg-white rounded-full">
          <span class="absolute inset-0 bg-white rounded-full animate-ping opacity-30"></span>
        </span>
        006 // GET IN TOUCH
      </span>

      <h2 class="text-[clamp(3rem,8vw,8rem)] font-black italic uppercase leading-[0.87] tracking-tighter text-white">
        {headline.split(' ').slice(0, -1).join(' ')}{' '}
        <span class="text-outline not-italic">{headline.split(' ').slice(-1)[0]}</span>
      </h2>

      <p class="text-[15px] md:text-base text-white/50 leading-relaxed max-w-md">
        {subtext}
      </p>

      <div class="flex items-center gap-6 mt-2">
        <a
          id="cta-magnetic"
          href={buttonHref}
          class="group/cta inline-flex items-center gap-4"
        >
          <span class="w-14 h-14 rounded-full border border-white/15 flex items-center justify-center group-hover/cta:bg-white transition-all duration-500">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="group-hover/cta:stroke-black stroke-white transition-colors duration-500">
              <path d="M7 17L17 7M17 7H8M17 7V16" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="font-mono text-[11px] font-bold text-white uppercase tracking-[0.2em]">
            {buttonText}
          </span>
        </a>

        {secondaryLinkText && secondaryLinkHref && (
          <a href={secondaryLinkHref} class="font-mono text-[11px] text-white/55 hover:text-white uppercase tracking-[0.2em] transition-colors duration-300">
            {secondaryLinkText}
          </a>
        )}
      </div>
    </div>

    <!-- Right contact deck -->
    <div class="md:col-span-5 flex flex-col gap-3">
      <div class="glass-panel p-6 md:p-7">
        <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.25em] block mb-3">
          007 // RESPONSE TIME
        </span>
        <h3 class="text-3xl font-black italic tracking-tighter text-white">&lt; 24 HRS</h3>
        <p class="font-mono text-[10px] text-white/55 uppercase tracking-[0.2em] mt-3">
          On weekdays · Same day for urgent
        </p>
      </div>
      <div class="glass-panel p-6 md:p-7">
        <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.25em] block mb-3">
          008 // AVAILABILITY
        </span>
        <div class="flex items-center gap-3">
          <span class="relative w-2 h-2 bg-white rounded-full">
            <span class="absolute inset-0 bg-white rounded-full animate-ping opacity-30"></span>
          </span>
          <h3 class="text-3xl font-black italic tracking-tighter text-white">Open</h3>
        </div>
        <p class="font-mono text-[10px] text-white/55 uppercase tracking-[0.2em] mt-3">
          Available for requests
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  // Magnetic CTA
  const cta = document.getElementById('cta-magnetic') as HTMLElement | null;
  if (cta) {
    const onMove = (e: MouseEvent) => {
      const r = cta.getBoundingClientRect();
      const cx = r.left + r.width / 2;
      const cy = r.top + r.height / 2;
      const d = Math.hypot(e.clientX - cx, e.clientY - cy);
      if (d < 180) {
        cta.style.transform = `translate(${(e.clientX - cx) * 0.3}px, ${(e.clientY - cy) * 0.3}px)`;
      } else {
        cta.style.transform = '';
      }
    };
    cta.style.transition = 'transform 0.5s cubic-bezier(0.16, 1, 0.3, 1)';
    window.addEventListener('mousemove', onMove);
  }

  // Watermark drift
  const wm = document.getElementById('cta-watermark') as HTMLElement | null;
  if (wm) {
    let x = 0, tx = 0;
    const onMove = (e: MouseEvent) => {
      tx = ((e.clientX / window.innerWidth) - 0.5) * 60;
    };
    const loop = () => {
      x += (tx - x) * 0.05;
      wm.style.transform = `translate3d(${x}px, 0, 0)`;
      requestAnimationFrame(loop);
    };
    window.addEventListener('mousemove', onMove);
    loop();
  }
</script>

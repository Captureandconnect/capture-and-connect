---
import { services } from '../../data/services';

function titleLines(title: string): string[] {
  const words = title.split(' ');
  const lines: string[] = [];
  for (const w of words) {
    if (lines.length && lines[lines.length - 1] === '&') {
      lines[lines.length - 1] = '& ' + w;
    } else {
      lines.push(w);
    }
  }
  return lines;
}
---

<section
  id="services-overview"
  class="relative bg-[#020202] pt-20 md:pt-24 pb-12 md:pb-14 overflow-hidden border-t border-white/[0.05]"
  aria-labelledby="services-heading"
>

  <!-- Section header: numbered command label + asymmetric headline -->
  <div class="relative max-w-[1600px] mx-auto px-6 md:px-10 lg:px-14 mb-12 md:mb-14">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-10 items-end">
      <div class="md:col-span-7">
        <span class="font-mono text-[11px] text-white/55 uppercase tracking-[0.25em] mb-6 flex items-center gap-3">
          <span class="inline-block w-8 h-px bg-white/30"></span>
          002 // SERVICES
        </span>
        <h2
          id="services-heading"
          class="text-[clamp(3rem,8vw,7.5rem)] font-black italic uppercase leading-[0.87] tracking-tighter text-white"
        >
          We grow<br/><span class="text-outline not-italic">brands.</span>
        </h2>
      </div>
      <p class="md:col-span-4 md:col-start-9 text-[15px] text-white/50 leading-relaxed">
        Three disciplines. One system. Built for one outcome: more views, more reach, more customers. From artists and festivals to brands and local businesses.
      </p>
    </div>
  </div>

  <!-- Glass command-cell grid -->
  <div class="relative max-w-[1600px] mx-auto px-6 md:px-10 lg:px-14">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5" id="services-grid">
      {services.map((service, idx) => {
        const number = String(idx + 1).padStart(3, '0');
        return (
          <a
            href={`/services#${service.id}`}
            class="service-cell glass-panel group relative flex flex-col p-7 md:p-9 min-h-[360px] md:min-h-[440px] overflow-hidden cursor-pointer"
            data-tilt
          >
            <!-- Hover spotlight follows cursor -->
            <div class="cell-spot pointer-events-none absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500" aria-hidden="true"></div>

            <!-- Top: ID + arrow icon -->
            <div class="relative flex items-center justify-between mb-10">
              <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.25em]">
                {number} // SERVICE
              </span>
              <span class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center group-hover:bg-white group-hover:border-white transition-all duration-500">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="group-hover:stroke-black stroke-white/70 group-hover:translate-x-0 -translate-x-px -translate-y-px transition-all duration-500">
                  <path d="M7 17L17 7M17 7H8M17 7V16" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>

            <!-- Massive italic title -->
            <h3 class="relative text-3xl md:text-4xl font-black italic uppercase leading-[0.95] tracking-tighter text-white mb-6">
              {titleLines(service.title).map((w, i) => i === 0 ? w : <><br/>{w}</>)}
            </h3>

            <!-- Description -->
            <p class="relative text-[14px] text-white/50 leading-relaxed mb-8">
              {service.description}
            </p>

            <!-- Bullet list with hairline dividers -->
            <ul class="relative mt-auto flex flex-col gap-0">
              {service.bullets.slice(0, 4).map((b) => (
                <li class="flex items-center gap-3 py-2.5 border-t border-white/[0.06] text-[13px] md:text-[12px] font-mono text-white/55 uppercase tracking-[0.1em]">
                  <span class="w-1 h-1 bg-white/40 rounded-full"></span>
                  <span>{b}</span>
                </li>
              ))}
              <li class="border-t border-white/[0.06]"></li>
            </ul>
          </a>
        );
      })}
    </div>

    <!-- Bottom CTA row -->
    <div class="mt-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <p class="font-mono text-[11px] text-white/55 uppercase tracking-[0.2em]">
        // Three services. One team. One outcome: growth.
      </p>
      <a href="/services" class="group/cta inline-flex items-center gap-4">
        <span class="w-12 h-12 rounded-full border border-white/15 flex items-center justify-center group-hover/cta:bg-white transition-all duration-500">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="group-hover/cta:stroke-black stroke-white transition-colors duration-500">
            <path d="M7 17L17 7M17 7H8M17 7V16" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="font-mono text-[11px] font-bold text-white uppercase tracking-[0.2em]">
          See How We Grow Brands
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .cell-spot {
    background: radial-gradient(
      400px circle at var(--mx, 50%) var(--my, 50%),
      rgba(255, 255, 255, 0.06),
      transparent 60%
    );
  }
  .service-cell {
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.5s ease;
    transform-style: preserve-3d;
    will-change: transform;
  }
</style>

<script>
  const cells = document.querySelectorAll<HTMLElement>('.service-cell');
  cells.forEach((cell) => {
    cell.addEventListener('mousemove', (e) => {
      const r = cell.getBoundingClientRect();
      const x = e.clientX - r.left;
      const y = e.clientY - r.top;
      const rx = ((y / r.height) - 0.5) * -6;
      const ry = ((x / r.width) - 0.5) * 6;
      cell.style.transform = `perspective(900px) rotateX(${rx}deg) rotateY(${ry}deg) translateY(-3px)`;
      cell.style.setProperty('--mx', `${x}px`);
      cell.style.setProperty('--my', `${y}px`);
    });
    cell.addEventListener('mouseleave', () => {
      cell.style.transform = '';
    });
  });
</script>

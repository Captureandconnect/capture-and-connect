---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Brand {
  name: string;
  src: ImageMetadata;
  href?: string;
}

// Eager-import every logo file so Astro processes and ships them at build time.
const logoMap = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/logos/*.{svg,png,webp,jpg}',
  { eager: true }
);
const logo = (filename: string): ImageMetadata => {
  const key = `../../assets/logos/${filename}`;
  const mod = logoMap[key];
  if (!mod) throw new Error(`TrustedBy: missing src/assets/logos/${filename}`);
  return mod.default;
};

const brands: Brand[] = [
  { name: 'Tomorrowland',         src: logo('tomorrowland.svg'),         href: 'https://www.tomorrowland.com/' },
  { name: 'Defqon.1',             src: logo('defqon1.svg'),              href: 'https://www.defqon1.com/' },
  { name: 'Masters Of Hardcore',  src: logo('masters-of-hardcore.svg'),  href: 'https://www.mastersofhardcore.com/' },
  { name: 'Rebirth Festival',     src: logo('rebirth.svg'),              href: 'https://www.rebirth-festival.nl/' },
  { name: 'Reverze',              src: logo('reverze.png'),              href: 'https://www.reverze.be/' },
  { name: 'Paaspop',              src: logo('paaspop.png'),              href: 'https://www.paaspop.nl/' },
  { name: 'Ground Zero',          src: logo('ground-zero.webp'),         href: 'https://www.groundzerofestival.nl/' },
  { name: 'BKJN Events',          src: logo('bkjn.png'),                 href: 'https://bkjn.nl/' },
  { name: 'Dimitri K',            src: logo('dimitri-k.png'),            href: 'https://dimitrikofficial.com/' },
  { name: 'Hard Dance Store',     src: logo('hard-dance-store.png'),     href: 'https://harddancestore.com/' },
];

// Duplicate the track twice so the CSS animation can loop seamlessly.
const track = [...brands, ...brands];
---

<section
  class="relative bg-[#020202] py-16 md:py-20 border-t border-white/[0.05] overflow-hidden"
  aria-labelledby="trusted-heading"
>
  <div class="relative max-w-[1600px] mx-auto px-6 md:px-10 lg:px-14">

    <!-- Section header -->
    <div class="mb-12 md:mb-14 grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-10 items-end">
      <div class="md:col-span-7">
        <span class="font-mono text-[11px] text-white/55 uppercase tracking-[0.25em] mb-6 flex items-center gap-3">
          <span class="inline-block w-8 h-px bg-white/30" aria-hidden="true"></span>
          005 // TRUSTED BY
        </span>
        <h2
          id="trusted-heading"
          class="text-[clamp(3rem,8vw,7.5rem)] font-black italic uppercase leading-[0.95] tracking-tighter text-white"
        >
          Worked <br/><span class="text-outline not-italic">with.</span>
        </h2>
      </div>
      <p class="md:col-span-4 md:col-start-9 text-[15px] text-white/50 leading-relaxed">
        Festivals, brands and artists we've helped grow. Real names, real stages, real reach.
      </p>
    </div>

  </div>

  <!-- Marquee — full bleed, edge-fades on the sides -->
  <div class="logo-marquee" aria-hidden="false">
    <div class="logo-marquee__track">
      {track.map((brand, i) => {
        const Cell = brand.href ? 'a' : 'div';
        return (
          <Cell
            class="logo-marquee__cell"
            {...(brand.href
              ? { href: brand.href, target: '_blank', rel: 'noopener noreferrer' }
              : {})}
            data-event="trusted_by_click"
            data-event-id={brand.name}
            aria-label={i < brands.length ? `${brand.name} — open site` : undefined}
            aria-hidden={i >= brands.length ? 'true' : undefined}
            tabindex={i >= brands.length ? -1 : undefined}
          >
            <Picture
              src={brand.src}
              alt={i < brands.length ? brand.name : ''}
              widths={[160, 320]}
              sizes="160px"
              loading="lazy"
              decoding="async"
              formats={['avif', 'webp']}
              class="logo-marquee__img"
            />
          </Cell>
        );
      })}
    </div>
  </div>
</section>

<style>
  .logo-marquee {
    position: relative;
    width: 100%;
    overflow: hidden;
    /* Soft edge-fade so logos don't pop in/out abruptly. */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
            mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .logo-marquee__track {
    display: flex;
    align-items: center;
    gap: 4rem;
    width: max-content;
    padding: 0 2rem;
    animation: logo-scroll 50s linear infinite;
  }

  /* Pause when the user hovers, so they can read a logo before it slides off. */
  .logo-marquee:hover .logo-marquee__track {
    animation-play-state: paused;
  }

  .logo-marquee__cell {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 84px;
    width: 200px;
    flex-shrink: 0;
    padding: 8px 0;
    /* Render every logo white so the wall reads as one set, not a mix of brands. */
    filter: brightness(0) invert(1);
    opacity: 0.55;
    transition: opacity 0.3s ease;
  }
  a.logo-marquee__cell:hover { opacity: 1; }

  /* The Astro <Picture> wrapper needs to fill the cell so the inner <img>'s
     height: 100% has something to measure against; otherwise some logos paint
     at their intrinsic size and overflow the cell. */
  .logo-marquee__cell picture {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }
  .logo-marquee__img {
    max-height: 100%;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  /* Halve the gap on small screens so more logos are visible. */
  @media (max-width: 640px) {
    .logo-marquee__track { gap: 2.5rem; }
    .logo-marquee__cell { height: 64px; width: 150px; }
  }

  /* Respect reduced-motion: freeze the marquee. */
  @media (prefers-reduced-motion: reduce) {
    .logo-marquee__track { animation: none; }
  }

  /* Track moves by exactly half its width — because we render the brand list
     twice, that lands the second copy seamlessly where the first started. */
  @keyframes logo-scroll {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-50%, 0, 0); }
  }
</style>

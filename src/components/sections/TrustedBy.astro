---
const brands = [
  { name: 'The Dope Doctor', role: 'Artist' },
  { name: 'Major Conspiracy', role: 'Duo' },
  { name: 'Hard Dance Store', role: 'Brand' },
  { name: 'Hairmoment', role: 'Studio' },
  { name: 'BKJN vs Partyraiser', role: 'Event' },
  { name: 'Masters Of Hardcore', role: 'Festival' },
];
---

<section
  class="relative bg-[#020202] py-16 md:py-20 border-t border-white/[0.05]"
  aria-labelledby="trusted-heading"
>
  <div class="relative max-w-[1600px] mx-auto px-6 md:px-10 lg:px-14">

    <!-- Section header -->
    <div class="mb-10 md:mb-12">
      <span class="font-mono text-[11px] text-white/55 uppercase tracking-[0.25em] mb-4 flex items-center gap-3">
        <span class="inline-block w-8 h-px bg-white/30" aria-hidden="true"></span>
        005 // TRUSTED BY
      </span>
      <p id="trusted-heading" class="text-[15px] text-white/55 leading-relaxed">
        The brands and artists we've helped grow.
      </p>
    </div>

    <!-- Logo wall -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 border border-white/[0.05]">
      {brands.map((brand, idx) => {
        const isLastInRow2Col = (idx + 1) % 2 === 0;
        const isLastInRow3Col = (idx + 1) % 3 === 0;
        const isLastOverall = idx === brands.length - 1;
        return (
          <div
            class:list={[
              'brand-cell group relative flex flex-col items-center justify-center min-h-[88px] p-5 gap-2 transition-colors duration-300',
              !isLastOverall && 'border-b border-white/[0.06] lg:border-b-0',
              !isLastInRow2Col && 'border-r border-white/[0.06] md:border-r-0',
              !isLastInRow3Col && 'md:border-r md:border-white/[0.06] lg:border-r-0',
              idx !== brands.length - 1 && 'lg:border-r lg:border-white/[0.06]',
            ]}
          >
            <span class="wordmark font-black italic uppercase tracking-[-0.04em] text-center text-[clamp(0.65rem,1.5vw,0.9rem)] leading-tight transition-colors duration-300 ease-out">
              {brand.name}
            </span>
            <span class="font-mono text-[9px] text-white/35 uppercase tracking-[0.25em]">
              {brand.role}
            </span>
          </div>
        );
      })}
    </div>

  </div>
</section>

<style>
  .brand-cell .wordmark {
    color: rgba(255, 255, 255, 0.35);
  }

  @media (hover: hover) {
    .brand-cell:hover .wordmark {
      color: rgba(255, 255, 255, 1);
    }
  }

  @media (hover: none) {
    .brand-cell .wordmark {
      color: rgba(255, 255, 255, 0.55);
    }
  }
</style>

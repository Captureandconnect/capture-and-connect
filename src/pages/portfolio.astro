---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Lightbox from '../components/ui/Lightbox.astro';
import CtaBlock from '../components/sections/CtaBlock.astro';
import EventsArchive from '../components/sections/EventsArchive.astro';
import ReelsGrid from '../components/sections/ReelsGrid.astro';
import { portfolioItems } from '../data/portfolio.ts';
import { events } from '../data/events.ts';
import { portfolioImage } from '../lib/portfolioImages';
import SectionLabel from '../components/ui/SectionLabel.astro';

const mediaSections = [
  {
    id: 'content-creation',
    n: 2,
    label: 'Content Creation',
    headline: ['Cinematic', 'content.'],
    description: 'High-impact visuals from artists, events and brands. Built to perform on TikTok, Instagram and YouTube.',
    ctaText: 'Start Growing Your Brand',
    ctaNote: 'From single Reels to full event coverage.',
  },
  {
    id: 'social-media',
    n: 3,
    label: 'Social Media',
    headline: ['Socials', 'we run.'],
    description: 'Accounts we manage and grow every day. Real growth, real numbers, no guesswork.',
    ctaText: 'Start Growing Your Brand',
    ctaNote: 'Consistent posting. Real growth. Zero guesswork.',
  },
] as const;

const managedAccounts = [
  {
    id: '01',
    handle: 'thedopedoctor_official',
    name: 'The Dope Doctor',
    role: 'Artist',
    avatar: 'avatar-dopedoctor.jpg',
    instagram: 'https://www.instagram.com/thedopedoctor_official/',
    tiktok: 'https://www.tiktok.com/@thedopedoctor_official',
    highlight: 'Viral moments',
    summary: 'Cinematic artist content built around live shows, the booth and the scroll.',
    stats: [
      { value: '90K',   label: 'Followers IG + TT' },
      { value: 'Live',  label: 'Always-on content' },
      { value: 'Daily', label: 'Posting cadence' },
    ],
  },
  {
    id: '02',
    handle: 'majorconspiracyofficial',
    name: 'Major Conspiracy',
    role: 'Uptempo Duo',
    avatar: 'avatar-majorconspiracy.jpg',
    instagram: 'https://www.instagram.com/majorconspiracyofficial/',
    tiktok: 'https://www.tiktok.com/@majorconspiracyofficial',
    highlight: 'Audience build',
    summary: 'Full management for a rising uptempo duo. Brand, content, posting, growth.',
    stats: [
      { value: '116K',  label: 'Followers IG + TT' },
      { value: 'Reels', label: 'Short-form first' },
      { value: 'Weekly', label: 'New content drop' },
    ],
  },
  {
    id: '03',
    handle: 'harddancestore',
    name: 'Hard Dance Store',
    role: 'Brand',
    avatar: 'avatar-harddancestore.jpg',
    instagram: 'https://www.instagram.com/harddancestore/',
    tiktok: 'https://www.tiktok.com/@harddancestore',
    highlight: 'Brand voice',
    summary: 'Lifestyle content for a hard dance apparel brand. Drops, events and community-led posts.',
    stats: [
      { value: '15K',   label: 'Followers IG + TT' },
      { value: 'Drops', label: 'Campaign rollouts' },
      { value: 'UGC',   label: 'Community-led' },
    ],
  },
];

const webDesignFeatures = [
  { id: '01', title: 'Custom design',     body: 'No templates. Every site designed from scratch around your brand and your goals.' },
  { id: '02', title: 'Mobile-first',      body: 'Your audience lives on mobile. Every site we ship looks flawless on any screen.' },
  { id: '03', title: 'Lightning fast',    body: 'Built for speed and SEO. Loads instantly. Ranks where it should.' },
  { id: '04', title: 'Conversion pages',  body: 'Landing pages and microsites engineered to turn traffic into leads, bookings and sales.' },
  { id: '05', title: 'Domain & hosting',  body: 'Domain, hosting, SSL — fully handled. You stay focused on the business.' },
  { id: '06', title: 'Fully yours',       body: 'No platform fees, no lock-in. The code is yours and the domain stays in your name — we just handle the setup and hosting for you.' },
];
---

<BaseLayout
  title="Event & Artist Portfolio — Work That Performs | Capture & Connect"
  fullTitle={true}
  description="Browse Capture & Connect's portfolio — event films, festival aftermovies, viral artist content and managed social accounts. Real numbers, real growth."
  ogImage="/og-portfolio.jpg"
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Portfolio', href: '/portfolio/' },
  ]}
>

  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="relative bg-[#020202] pt-32 pb-16 md:pt-40 md:pb-20 overflow-hidden">
    <div class="relative max-w-[1600px] mx-auto px-6 md:px-10 lg:px-14">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-10 items-end">
        <div class="md:col-span-8">
          <SectionLabel n={1} label="Portfolio" marker="dot" class="mb-6" />
          <h1 class="text-[clamp(3.5rem,9vw,9rem)] font-black italic uppercase leading-[0.95] tracking-tighter text-white">
            Work that <br/><span class="text-outline not-italic">performs.</span>
          </h1>
        </div>
        <p class="md:col-span-4 text-[15px] text-white/50 leading-relaxed">
          Real content. Real results. Everything you see is live and verifiable.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Sticky tabs — wrap on small mobile so all 3 categories are visible ── -->
  <nav
    id="portfolio-nav"
    class="sticky top-0 z-40 bg-[#020202]/80 backdrop-blur-xl border-y border-white/[0.06] transition-all duration-300"
    aria-label="Portfolio categories"
  >
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 md:px-10 lg:px-14">
      <div class="flex flex-wrap sm:flex-nowrap gap-2 py-3 sm:py-4">
        {[
          { id: 'content-creation', label: 'Content', n: '01' },
          { id: 'social-media',     label: 'Social',  n: '02' },
          { id: 'web-design',       label: 'Web',     n: '03' },
        ].map((tab, i) => (
          <a
            href={`#${tab.id}`}
            class:list={[
              'portfolio-tab flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-3 sm:px-4 py-3 font-mono text-[11px] uppercase tracking-[0.2em] border transition-all duration-300 cursor-pointer select-none whitespace-nowrap min-h-[44px]',
              i === 0
                ? 'border-white text-white bg-white/[0.04]'
                : 'border-white/10 text-white/55 hover:border-white/40 hover:text-white',
            ]}
            data-tab={tab.id}
            data-event={`portfolio_filter_${tab.id}`}
          >
            <span class="text-[9px] text-white/55" aria-hidden="true">{tab.n}</span>
            <span>{tab.label}</span>
          </a>
        ))}
      </div>
    </div>
  </nav>

  <!-- ── Media sections (Content Creation + Social Media) ─────────────── -->
  {mediaSections.map((section) => {
    const allItems = portfolioItems.filter((item) => item.category === section.id);
    // Hide event-* items inside content-creation (they live in EventsArchive now)
    const items =
      section.id === 'content-creation'
        ? allItems.filter((item) => !item.id.startsWith('event-'))
        : allItems;

    return (
      <section
        id={section.id}
        class="portfolio-section relative bg-[#020202] py-20 md:py-24 overflow-hidden border-t border-white/[0.05] scroll-mt-24"
      >
        <div class="relative max-w-[1600px] mx-auto px-6 md:px-10 lg:px-14">

          {section.id === 'content-creation' ? (
            <!-- Content Creation: thin horizontal header bar, gallery-first -->
            <div class="mb-10 md:mb-12 flex flex-col md:flex-row md:items-end gap-4 md:gap-8 border-b border-white/[0.06] pb-6">
              <div class="flex items-center gap-4 shrink-0">
                <span class="font-mono text-[11px] text-white uppercase tracking-[0.25em]">
                  {String(section.n).padStart(3, '0')} // {section.label}
                </span>
              </div>
              <span class="hidden md:block flex-1 h-px bg-white/10"></span>
              <p class="md:max-w-md text-[13px] text-white/50 leading-relaxed">
                {section.description}
              </p>
              <span class="hidden md:block w-8 h-px bg-white/10"></span>
              <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.25em] shrink-0">
                {events.length + items.length} works
              </span>
            </div>
          ) : (
            <!-- Social Media: split layout, solid italic (no outline repeat) -->
            <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-10 mb-10 md:mb-12 items-start">
              <div class="md:col-span-4 flex flex-col gap-5">
                <span class="font-mono text-[11px] text-white/55 uppercase tracking-[0.25em] flex items-center gap-3">
                  <span class="relative w-1.5 h-1.5 rounded-full bg-white shrink-0">
                    <span class="absolute inset-0 rounded-full bg-white animate-ping opacity-30"></span>
                  </span>
                  <span>{String(section.n).padStart(3, '0')} // {section.label.toUpperCase()}</span>
                </span>
                <h2 class="text-[clamp(2rem,5vw,4rem)] font-black italic uppercase leading-[0.9] tracking-tighter text-white">
                  Socials <br/>built to <br/>grow.
                </h2>
                <div class="h-px w-16 bg-white/20"></div>
                <p class="text-[14px] text-white/55 leading-relaxed max-w-sm">
                  {section.description}
                </p>
              </div>
              <div class="md:col-span-8 grid grid-cols-2 gap-px bg-white/[0.04] border border-white/[0.05] self-stretch">
                <div class="bg-[#020202] p-6 flex flex-col justify-between gap-3">
                  <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.25em]">// ACCOUNTS LIVE</span>
                  <h3 class="text-5xl md:text-6xl font-black italic tracking-tighter text-white leading-none">9</h3>
                  <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.2em]">6 Instagram, 3 TikTok</span>
                </div>
                <div class="bg-[#020202] p-6 flex flex-col justify-between gap-3">
                  <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.25em]">// COMBINED REACH</span>
                  <h3 class="text-5xl md:text-6xl font-black italic tracking-tighter text-white leading-none">16M+</h3>
                  <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.2em]">The nine accounts we run day to day</span>
                </div>
              </div>
            </div>
          )}

          <!-- Managed accounts deck (Social Media only) -->
          {section.id === 'social-media' && (
            <div class="mb-10 md:mb-12">
              <div class="flex items-end justify-between flex-wrap gap-4 mb-6">
                <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.25em]">
                  // Featured · 3 of 9
                </span>
                <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.2em]">
                  Tap any cell to see the live work
                </span>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-white/[0.04] border border-white/[0.05]">
                {managedAccounts.map((account) => (
                  <a
                    href={account.instagram}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="account-cell group relative bg-[#020202] hover:bg-[#070707] transition-colors duration-500 p-7 md:p-9 flex flex-col gap-5 min-h-[360px]"
                    aria-label={`Open Instagram profile of ${account.name}`}
                    data-event="portfolio_tile_click"
                    data-event-id={account.handle}
                    data-event-location="social_media_accounts"
                  >
                    <!-- ID + dot -->
                    <div class="flex items-center justify-between">
                      <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.25em]">
                        {account.id} // {account.role.toUpperCase()}
                      </span>
                      <span class="relative w-1.5 h-1.5 rounded-full bg-white">
                        <span class="absolute inset-0 rounded-full bg-white animate-ping opacity-30"></span>
                      </span>
                    </div>

                    <!-- Avatar + name + handle -->
                    <div class="flex items-center gap-4">
                      <Picture
                        src={portfolioImage(account.avatar)}
                        alt={`${account.name} — Instagram profile`}
                        loading="lazy"
                        decoding="async"
                        widths={[64, 128]}
                        sizes="64px"
                        formats={['avif', 'webp']}
                        class="w-14 h-14 md:w-16 md:h-16 rounded-full object-cover border border-white/15 shrink-0"
                      />
                      <div class="flex flex-col gap-1.5 min-w-0">
                        <h3 class="text-2xl md:text-[2rem] font-black italic uppercase leading-[0.95] tracking-tighter text-white break-words">
                          {account.name}
                        </h3>
                        <span class="font-mono text-[11px] text-white/55 uppercase tracking-[0.2em] truncate">
                          @{account.handle}
                        </span>
                      </div>
                    </div>

                    <!-- Headline highlight -->
                    <div class="flex items-baseline gap-2">
                      <span class="text-2xl font-black italic tracking-tighter text-white">{account.highlight}</span>
                    </div>

                    <!-- Hairline grows on hover -->
                    <div class="h-px w-12 bg-white/10 group-hover:w-full group-hover:bg-white/30 transition-all duration-700"></div>

                    <!-- Summary -->
                    <p class="text-[13px] text-white/55 leading-relaxed">{account.summary}</p>

                    <!-- Stats row -->
                    <div class="mt-auto grid grid-cols-3 gap-px bg-white/[0.04] border border-white/[0.05]">
                      {account.stats.map((s) => (
                        <div class="bg-[#020202] p-3 flex flex-col gap-1">
                          <span class="text-base font-black italic tracking-tighter text-white leading-none">{s.value}</span>
                          <span class="font-mono text-[8px] text-white/55 uppercase tracking-[0.15em] leading-tight">{s.label}</span>
                        </div>
                      ))}
                    </div>

                    <!-- Footer: platforms + arrow -->
                    <div class="flex items-center justify-between pt-3 border-t border-white/[0.06]">
                      <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.2em]">
                        IG · TT
                      </span>
                      <span class="w-9 h-9 rounded-full border border-white/10 flex items-center justify-center group-hover:bg-white transition-all duration-500">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" class="group-hover:stroke-black stroke-white/70 transition-colors duration-500">
                          <path d="M7 17L17 7M17 7H8M17 7V16" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}

          <!-- Events archive (content-creation only) -->
          {section.id === 'content-creation' && <EventsArchive />}

          <!-- Reels grid temporarily offline — re-enable when reel data is finalised -->
          {/* {section.id === 'content-creation' && <ReelsGrid />} */}

          <!-- Section sub-header: artist work -->
          {section.id === 'content-creation' && items.length > 0 && (
            <div class="flex items-end justify-between flex-wrap gap-4 mb-6 pb-5 border-b border-white/[0.06]">
              <div class="flex items-baseline gap-4">
                <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.25em]">// Artist work</span>
                <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.2em] hidden md:inline-flex items-center gap-2">
                  <span class="w-3 h-px bg-white/20"></span>
                  Promo · viral · campaign
                </span>
              </div>
              <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.2em]">
                {items.length} {items.length === 1 ? 'work' : 'works'}
              </span>
            </div>
          )}

          <!-- Item grid: monolith asymmetric -->
          {items.length > 0 && (
            <div class="grid grid-cols-1 md:grid-cols-6 gap-4 md:gap-5">
              {items.map((item, idx) => {
                const number = String(idx + 1).padStart(2, '0');
                const span = idx === 0 ? 'md:col-span-4' : 'md:col-span-2';
                const aspect = idx === 0 ? 'aspect-[16/9]' : 'aspect-[4/5]';
                const isExternal = item.video?.startsWith('http');
                const href = item.video ?? '#';
                return (
                  <a
                    href={href}
                    target={isExternal ? '_blank' : undefined}
                    rel={isExternal ? 'noopener noreferrer' : undefined}
                    class={`portfolio-cell group relative block ${span} overflow-hidden bg-[#0a0a0a] border border-white/[0.06] hover:border-white/20 transition-all duration-700`}
                    data-event="portfolio_tile_click"
                    data-event-id={item.id}
                    data-event-location={section.id}
                  >
                    <div class={`relative ${aspect} overflow-hidden`}>
                      <Picture
                        src={portfolioImage(item.thumbnail)}
                        alt={`${item.title} — ${item.client} ${section.id === 'content-creation' ? 'content' : 'social'} by Capture & Connect`}
                        loading="lazy"
                        decoding="async"
                        widths={[400, 800, 1200]}
                        sizes={idx === 0 ? '(min-width: 768px) 66vw, 100vw' : '(min-width: 768px) 33vw, 100vw'}
                        formats={['avif', 'webp']}
                        class="absolute inset-0 w-full h-full object-cover scale-105 group-hover:scale-100 transition-transform duration-1000"
                      />
                      <div class="absolute inset-0 bg-gradient-to-t from-[#020202] via-[#020202]/50 to-transparent opacity-90"></div>

                      {item.stats && (
                        <div class="absolute top-4 right-4 glass-panel px-3 py-1.5">
                          <span class="font-mono text-[10px] text-white uppercase tracking-[0.15em]">{item.stats}</span>
                        </div>
                      )}

                      <div class="absolute top-4 left-4">
                        <span class="font-mono text-[10px] text-white/60 uppercase tracking-[0.25em]">
                          {number} // {item.category === 'content-creation' ? 'CONTENT' : 'SOCIAL'}
                        </span>
                      </div>

                      <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-500">
                        <span class="w-16 h-16 md:w-20 md:h-20 rounded-full glass-panel flex items-center justify-center backdrop-blur-md">
                          <svg width="22" height="22" viewBox="0 0 24 24" fill="white" class="ml-1">
                            <path d="M5 4l14 8-14 8z"/>
                          </svg>
                        </span>
                      </div>
                    </div>

                    <div class="absolute bottom-0 left-0 right-0 p-5 md:p-6 flex flex-col gap-2">
                      <h3 class="text-xl md:text-2xl font-black italic uppercase leading-[1] tracking-tighter text-white">
                        {item.title}
                      </h3>
                      <div class="flex items-center justify-between">
                        <span class="font-mono text-[10px] text-white/50 uppercase tracking-[0.2em]">{item.client}</span>
                        <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.2em] flex items-center gap-2">
                          View
                          <span class="w-3 h-px bg-white/30 group-hover:w-6 group-hover:bg-white transition-all duration-500"></span>
                        </span>
                      </div>
                    </div>
                  </a>
                );
              })}
            </div>
          )}

          <!-- Section CTA -->
          <div class="mt-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
            <p class="font-mono text-[11px] text-white/55 uppercase tracking-[0.2em] max-w-md">
              // {section.ctaNote}
            </p>
            <a href="mailto:info@captureandconnect.nl" class="group/cta inline-flex items-center gap-4" data-event="cta_book_call" data-event-location={`portfolio_${section.id}`}>
              <span class="w-12 h-12 rounded-full border border-white/15 flex items-center justify-center group-hover/cta:bg-white transition-all duration-500">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="group-hover/cta:stroke-black stroke-white transition-colors duration-500">
                  <path d="M7 17L17 7M17 7H8M17 7V16" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span class="font-mono text-[11px] font-bold text-white uppercase tracking-[0.2em]">
                {section.ctaText}
              </span>
            </a>
          </div>

        </div>
      </section>
    );
  })}

  <!-- ── Web Design ───────────────────────────────────────────────────── -->
  <section
    id="web-design"
    class="portfolio-section relative bg-[#020202] py-20 md:py-24 overflow-hidden border-t border-white/[0.05] scroll-mt-24"
  >
    <div class="relative max-w-[1600px] mx-auto px-6 md:px-10 lg:px-14">

      <!-- Manifesto-style header: solid italic (no outline repeat), editorial pull-quote -->
      <div class="mb-12 md:mb-16 flex flex-col gap-6">
        <div class="flex items-center gap-4">
          <span class="font-mono text-[11px] text-white uppercase tracking-[0.25em]">004 // WEB DESIGN</span>
          <span class="h-px flex-1 bg-white/10"></span>
        </div>
        <p class="text-[clamp(1.5rem,3vw,2.5rem)] font-medium leading-[1.15] tracking-tight text-white max-w-4xl">
          Websites built to <span class="text-white/55">convert.</span><br/>
          Six reasons every site we <br/>ship <em class="font-black italic text-white">performs.</em>
        </p>
      </div>

      <!-- Live Websites — case grid -->
      <div class="mb-16 md:mb-20">
        <div class="flex items-center gap-4 mb-8 md:mb-10">
          <span class="font-mono text-[11px] text-white/55 uppercase tracking-[0.25em]">// Live Websites</span>
          <span class="h-px flex-1 bg-white/[0.06]"></span>
          <span class="font-mono text-[11px] text-white/45 tracking-[0.25em]">2</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-5">
          {[
            {
              title: 'Hairmoment · Hair Salon Noordwijk',
              tag: 'Hospitality · Local Business',
              cover: 'cover-hairmoment-v4.jpg',
              href: 'https://hairmoment.nl/',
              meta: ['Custom Astro build', 'Mobile-first', 'Live at hairmoment.nl'],
              note: 'New visual identity and booking flow. From first sketch to live in two weeks. Built to convert.',
            },
            {
              title: 'Capture & Connect · This Site',
              tag: 'Creative Agency · In-House',
              cover: 'cover-captureandconnect-v2.jpg',
              href: 'https://captureandconnect.nl/',
              meta: ['Astro + React', 'Cloudflare Pages', 'Custom design, no template'],
              note: 'Built entirely in-house. No WordPress, no drag-and-drop. Just custom code, custom motion, custom typography.',
            },
          ].map((site, idx) => {
            const number = String(idx + 1).padStart(2, '0');
            return (
              <a
                href={site.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group relative block overflow-hidden bg-[#0a0a0a] border border-white/[0.06] hover:border-white/25 transition-all duration-700"
                data-event="portfolio_tile_click"
                data-event-id={site.href.replace('https://', '').replace('/', '')}
                data-event-location="web_design"
              >
                <span class="absolute top-0 left-0 h-px w-12 bg-white transition-all duration-700 group-hover:w-full z-20" aria-hidden="true"></span>

                <div class="relative aspect-[4/5] md:aspect-[5/6] overflow-hidden">
                  <Picture
                    src={portfolioImage(site.cover)}
                    alt={`${site.title} — website by Capture & Connect`}
                    loading="lazy"
                    decoding="async"
                    widths={[400, 800, 1200]}
                    sizes="(min-width: 768px) 50vw, 100vw"
                    formats={['avif', 'webp']}
                    class="absolute inset-0 w-full h-full object-cover object-top scale-100 group-hover:scale-[1.02] transition-transform duration-1000"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-[#020202] from-30% via-[#020202]/55 to-transparent opacity-95"></div>

                  <div class="absolute top-4 left-4 right-4 z-10">
                    <span class="font-mono text-[10px] text-white/70 uppercase tracking-[0.25em]">
                      {number} // {site.tag}
                    </span>
                  </div>

                  <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-500">

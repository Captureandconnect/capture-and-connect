---
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamBlock from '../components/sections/TeamBlock.astro';
import CtaBlock from '../components/sections/CtaBlock.astro';

const values = [
  { id: '001', title: 'Quality over quantity', body: 'Everything we create is built to perform. No filler. No throwaway posts.' },
  { id: '002', title: 'Results over vanity',   body: 'Views are nice. Growth and revenue matter. We optimise for what moves the needle.' },
  { id: '003', title: 'Always improving',      body: 'Platforms shift weekly. We stay ahead so your content never falls behind.' },
  { id: '004', title: 'Partnership',           body: 'We don’t work for you. We work with you. Your growth is our growth.' },
];
---

<BaseLayout
  title="About Capture & Connect — Growth Partner for Artists & Brands"
  fullTitle={true}
  description="Capture & Connect is a Netherlands-based creative agency built by Ryan van der Niet. Content, social media and strategy that turn attention into measurable growth."
  ogImage="/og-about.jpg"
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'About', href: '/about/' },
  ]}
>

  <!-- Page Hero -->
  <section class="relative bg-[#020202] pt-32 pb-16 md:pt-40 md:pb-20 overflow-hidden">
    <div class="relative max-w-[1600px] mx-auto px-6 md:px-10 lg:px-14">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-10 items-end">
        <div class="md:col-span-8">
          <span class="font-mono text-[11px] text-white/55 uppercase tracking-[0.25em] mb-6 flex items-center gap-3">
            <span class="relative w-2 h-2 bg-white rounded-full">
              <span class="absolute inset-0 bg-white rounded-full animate-ping opacity-30"></span>
            </span>
            005 // ABOUT
          </span>
          <h1 class="text-[clamp(3.5rem,9vw,9rem)] font-black italic uppercase leading-[0.95] tracking-tighter text-white">
            Built for <br/><span class="text-outline not-italic">growth.</span>
          </h1>
        </div>
        <p class="md:col-span-4 text-[15px] text-white/50 leading-relaxed">
          From solo creator to full growth partner. We combine content, social media and strategy into one system that turns attention into results.
        </p>
      </div>
    </div>
  </section>

  <!-- Ryan's Story -->
  <TeamBlock />

  <!-- Values as command-cells -->
  <section class="relative bg-[#020202] py-20 md:py-24 overflow-hidden border-t border-white/[0.05]">
    <div class="relative max-w-[1600px] mx-auto px-6 md:px-10 lg:px-14">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-10 mb-12 md:mb-14 items-end">
        <div class="md:col-span-7">
          <span class="font-mono text-[11px] text-white/55 uppercase tracking-[0.25em] mb-6 flex items-center gap-3">
            <span class="inline-block w-8 h-px bg-white/30"></span>
            006 // VALUES
          </span>
          <h2 class="text-[clamp(2.5rem,7vw,6rem)] font-black italic uppercase leading-[0.95] tracking-tighter text-white">
            What <br/><span class="text-outline not-italic">drives us.</span>
          </h2>
        </div>
        <p class="md:col-span-4 md:col-start-9 text-[15px] text-white/50 leading-relaxed">
          Four principles behind every shoot, every edit, every line of code.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-white/[0.04] border border-white/[0.05]">
        {values.map((v) => (
          <div class="value-cell group bg-[#020202] hover:bg-[#070707] transition-colors duration-500 p-8 md:p-10 flex flex-col gap-5 min-h-[260px]">
            <div class="flex items-center justify-between">
              <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.25em]">{v.id} // VALUE</span>
              <span class="w-1.5 h-1.5 rounded-full bg-white/30 group-hover:bg-white transition-colors duration-500"></span>
            </div>
            <h3 class="text-3xl md:text-4xl font-black italic uppercase leading-[0.95] tracking-tighter text-white">
              {v.title}
            </h3>
            <div class="h-px w-12 bg-white/10 group-hover:w-full group-hover:bg-white/30 transition-all duration-700"></div>
            <p class="text-[14px] text-white/55 leading-relaxed">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CtaBlock
    headline="Ready to grow your brand?"
    subtext="Get a plan that turns content into views, followers and paying customers. Limited spots available each month."
    buttonText="Book Your Call"
    showWatermark={false}
  />

</BaseLayout>

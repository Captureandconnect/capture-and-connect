---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
---

<BaseLayout
  title="Contact — Book a Free Growth Call | Capture & Connect"
  fullTitle={true}
  description="Tell us where your brand is and where you want it to be. Capture & Connect replies to every brief within 24 hours, weekdays."
  ogImage="/og-contact.jpg"
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Contact', href: '/contact/' },
  ]}
>

  <!-- Page Hero -->
  <section class="relative bg-[#020202] pt-32 pb-12 md:pt-40 md:pb-16 overflow-hidden">
    <div class="relative max-w-[1600px] mx-auto px-6 md:px-10 lg:px-14">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-10 items-end">
        <div class="md:col-span-8">
          <SectionLabel n={1} label="Contact" marker="dot" class="mb-6" />
          <h1 class="text-[clamp(3.5rem,9vw,9rem)] font-black italic uppercase leading-[0.95] tracking-tighter text-white">
            Start your <br/><span class="text-outline not-italic">growth.</span>
          </h1>
        </div>
        <p class="md:col-span-4 text-[15px] text-white/50 leading-relaxed">
          Tell us where you are and where you want to go. We reply within 24 hours.
        </p>
      </div>
    </div>
  </section>

  <!-- Two-column layout -->
  <section class="relative bg-[#020202] pb-20 md:pb-24 border-t border-white/[0.05]">
    <div class="relative max-w-[1600px] mx-auto px-6 md:px-10 lg:px-14 pt-12 md:pt-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">

        <!-- Left: Form, takes 7 cols -->
        <div class="lg:col-span-7">
          <SectionLabel n={2} label="Project brief" marker="none" class="mb-6" />
          <div class="glass-panel p-4 md:p-8 lg:p-10">
            <ContactForm />
          </div>
        </div>

        <!-- Right: Direct contact deck, 5 cols -->
        <div class="lg:col-span-5 flex flex-col gap-3">
          <SectionLabel n={3} label="Direct lines" marker="none" class="mb-3" />

          <a href="mailto:info@captureandconnect.nl" class="contact-cell glass-panel p-7 group flex flex-col gap-3" data-event="contact_email" data-event-location="contact_direct_lines">
            <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.25em]">PRIMARY · EMAIL</span>
            <h3 class="text-3xl font-black italic tracking-tighter text-white">info@captureandconnect.nl</h3>
            <div class="flex items-center justify-between mt-2">
              <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.2em]">&lt; 24 hr response</span>
              <span class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center group-hover:bg-white transition-all duration-500">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="group-hover:stroke-black stroke-white/70 transition-colors duration-500">
                  <path d="M7 17L17 7M17 7H8M17 7V16" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </a>

          <a href="https://www.instagram.com/captureandconnect_" data-ig-deeplink="instagram://user?username=captureandconnect_" target="_blank" rel="noopener noreferrer" class="contact-cell glass-panel p-7 group flex flex-col gap-3" data-event="social_instagram" data-event-location="contact_direct_lines">
            <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.25em]">SOCIAL · INSTAGRAM</span>
            <h3 class="text-3xl font-black italic tracking-tighter text-white">@captureandconnect_</h3>
            <div class="flex items-center justify-between mt-2">
              <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.2em]">DM open · Daily content</span>
              <span class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center group-hover:bg-white transition-all duration-500">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="group-hover:stroke-black stroke-white/70 transition-colors duration-500">
                  <path d="M7 17L17 7M17 7H8M17 7V16" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </a>

          <a href="https://www.instagram.com/captureandconnect_" target="_blank" rel="noopener noreferrer" class="contact-cell glass-panel p-7 group flex flex-col gap-3" data-event="social_instagram_dm" data-event-location="contact_direct_lines" data-ig-deeplink="instagram://user?username=captureandconnect_">
            <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.25em]">DIRECT LINE · INSTAGRAM DM</span>
            <h3 class="text-3xl font-black italic tracking-tighter text-white">Send a DM</h3>
            <div class="flex items-center justify-between mt-2">
              <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.2em]">Opens app on mobile</span>
              <span class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center group-hover:bg-white transition-all duration-500">
                <!-- Instagram glyph -->
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="group-hover:stroke-black stroke-white/70 transition-colors duration-500" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                  <circle cx="12" cy="12" r="4"/>
                  <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
                </svg>
              </span>
            </div>
          </a>

          <div class="contact-cell glass-panel p-7 flex flex-col gap-3">
            <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.25em]">STATUS · AVAILABILITY</span>
            <div class="flex items-center gap-3">
              <span class="relative w-2 h-2 bg-white rounded-full">
                <span class="absolute inset-0 bg-white rounded-full animate-ping opacity-30"></span>
              </span>
              <h3 class="text-3xl font-black italic tracking-tighter text-white">Open</h3>
            </div>
            <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.2em] mt-2">Taking briefs now · Limited spots</span>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const cells = document.querySelectorAll<HTMLElement>('.contact-cell');
  cells.forEach((cell) => {
    cell.addEventListener('mousemove', (e) => {
      const r = cell.getBoundingClientRect();
      const x = e.clientX - r.left;
      const y = e.clientY - r.top;
      const rx = ((y / r.height) - 0.5) * -4;
      const ry = ((x / r.width) - 0.5) * 4;
      cell.style.transform = `perspective(900px) rotateX(${rx}deg) rotateY(${ry}deg)`;
    });
    cell.addEventListener('mouseleave', () => {
      cell.style.transform = '';
    });
  });
</script>

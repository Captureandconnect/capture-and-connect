---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/forms/ContactForm.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Capture & Connect. Ready to grow your brand? Reach out via our form, Instagram, or email — we respond within 24 hours."
>

  <!-- Page Hero -->
  <section class="relative bg-[#020202] pt-32 pb-12 md:pt-40 md:pb-16 overflow-hidden">
    <div class="relative max-w-[1600px] mx-auto px-6 md:px-10 lg:px-14">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-10 items-end">
        <div class="md:col-span-8">
          <span class="font-mono text-[11px] text-white/40 uppercase tracking-[0.25em] mb-6 flex items-center gap-3">
            <span class="relative w-2 h-2 bg-white rounded-full">
              <span class="absolute inset-0 bg-white rounded-full animate-ping opacity-30"></span>
            </span>
            006 // CONTACT
          </span>
          <h1 class="text-[clamp(3.5rem,9vw,9rem)] font-black italic uppercase leading-[0.87] tracking-tighter text-white">
            Let's<br/><span class="text-outline not-italic">talk.</span>
          </h1>
        </div>
        <p class="md:col-span-4 text-[15px] text-white/50 leading-relaxed">
          Tell us what you’re building. We reply within 24 hours on weekdays — same day if it’s urgent.
        </p>
      </div>
    </div>
  </section>

  <!-- Two-column layout -->
  <section class="relative bg-[#020202] pb-20 md:pb-24 border-t border-white/[0.05]">
    <div class="relative max-w-[1600px] mx-auto px-6 md:px-10 lg:px-14 pt-12 md:pt-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">

        <!-- Left: Form, takes 7 cols -->
        <div class="lg:col-span-7">
          <span class="font-mono text-[11px] text-white/30 uppercase tracking-[0.25em] block mb-6">
            007 // PROJECT BRIEF
          </span>
          <div class="glass-panel p-6 md:p-8 lg:p-10">
            <ContactForm />
          </div>
        </div>

        <!-- Right: Direct contact deck, 5 cols -->
        <div class="lg:col-span-5 flex flex-col gap-3">
          <span class="font-mono text-[11px] text-white/30 uppercase tracking-[0.25em] block mb-3">
            008 // DIRECT LINES
          </span>

          <a href="mailto:info@captureandconnect.nl" class="contact-cell glass-panel p-7 group flex flex-col gap-3">
            <span class="font-mono text-[10px] text-white/30 uppercase tracking-[0.25em]">PRIMARY · EMAIL</span>
            <h3 class="text-3xl font-black italic tracking-tighter text-white">info@captureandconnect.nl</h3>
            <div class="flex items-center justify-between mt-2">
              <span class="font-mono text-[10px] text-white/40 uppercase tracking-[0.2em]">&lt; 24 hr response</span>
              <span class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center group-hover:bg-white transition-all duration-500">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="group-hover:stroke-black stroke-white/70 transition-colors duration-500">
                  <path d="M7 17L17 7M17 7H8M17 7V16" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </a>

          <a href="https://www.instagram.com/captureandconnect_" target="_blank" rel="noopener noreferrer" class="contact-cell glass-panel p-7 group flex flex-col gap-3">
            <span class="font-mono text-[10px] text-white/30 uppercase tracking-[0.25em]">SOCIAL · INSTAGRAM</span>
            <h3 class="text-3xl font-black italic tracking-tighter text-white">@captureandconnect_</h3>
            <div class="flex items-center justify-between mt-2">
              <span class="font-mono text-[10px] text-white/40 uppercase tracking-[0.2em]">DM open · Daily content</span>
              <span class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center group-hover:bg-white transition-all duration-500">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="group-hover:stroke-black stroke-white/70 transition-colors duration-500">
                  <path d="M7 17L17 7M17 7H8M17 7V16" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </a>

          <div class="contact-cell glass-panel p-7 flex flex-col gap-3">
            <span class="font-mono text-[10px] text-white/30 uppercase tracking-[0.25em]">STATUS · AVAILABILITY</span>
            <div class="flex items-center gap-3">
              <span class="relative w-2 h-2 bg-white rounded-full">
                <span class="absolute inset-0 bg-white rounded-full animate-ping opacity-30"></span>
              </span>
              <h3 class="text-3xl font-black italic tracking-tighter text-white">Open</h3>
            </div>
            <span class="font-mono text-[10px] text-white/40 uppercase tracking-[0.2em] mt-2">Booking projects for Q3 / Q4</span>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const cells = document.querySelectorAll<HTMLElement>('.contact-cell');
  cells.forEach((cell) => {
    cell.addEventListener('mousemove', (e) => {
      const r = cell.getBoundingClientRect();
      const x = e.clientX - r.left;
      const y = e.clientY - r.top;
      const rx = ((y / r.height) - 0.5) * -4;
      const ry = ((x / r.width) - 0.5) * 4;
      cell.style.transform = `perspective(900px) rotateX(${rx}deg) rotateY(${ry}deg)`;
    });
    cell.addEventListener('mouseleave', () => {
      cell.style.transform = '';
    });
  });
</script>

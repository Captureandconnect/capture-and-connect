---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ExperienceHero } from '../components/ui/experience-hero';
import ServicesOverview from '../components/sections/ServicesOverview.astro';
import ResultsHighlight from '../components/sections/ResultsHighlight.astro';
import PortfolioPreview from '../components/sections/PortfolioPreview.astro';
import TrustedBy from '../components/sections/TrustedBy.astro';
import HowWeWork from '../components/sections/HowWeWork.astro';
import CtaBlock from '../components/sections/CtaBlock.astro';
import Lightbox from '../components/ui/Lightbox.astro';
---

<BaseLayout
  title="Content, Social Media & Web for Artists, Events & Brands | Capture & Connect"
  fullTitle={true}
  description="Capture & Connect — content production, social media management and conversion-built websites for artists, festivals and brands in the Netherlands. We grow audiences."
  ogImage="/og-home.jpg"
>
  <ExperienceHero client:idle />

  <ServicesOverview />

  <ResultsHighlight />

  <PortfolioPreview />

  <TrustedBy />

  <HowWeWork />

  <CtaBlock
    headline="Ready to grow?"
    subtext="Stop blending in. Tell us where you want your brand in 6 months — we send a written growth plan within a few days."
    buttonText="Book Your Free Call"
  />

  <Lightbox />
</BaseLayout>

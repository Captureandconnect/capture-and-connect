---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceDetail from '../components/sections/ServiceDetail.astro';
import CtaBlock from '../components/sections/CtaBlock.astro';
import { services } from '../data/services';
import SectionLabel from '../components/ui/SectionLabel.astro';
import { CTA_PRIMARY } from '../data/promises';

const faq = [
  {
    q: 'How fast can we get content live?',
    a: 'From first call to first post is under 30 days. Strategy and shoot scheduling in week one, production and editing in week two, polish and publish in week three.',
  },
  {
    q: 'Will you travel for shoots and events?',
    a: 'Yes. We shoot across the Netherlands as standard. Travel beyond NL, gear rental and venue fees are passed through at cost and listed in the proposal up front — no hidden line items.',
  },
  {
    q: 'Can I book a single shoot, or do I have to commit to a retainer?',
    a: 'Both. Event films, aftermovies and web builds are project-based. Social media management and ongoing content production run on monthly retainers with a three-month minimum. One-off shoots and edits stand on their own.',
  },
  {
    q: 'Do you build the strategy or just execute?',
    a: 'Both. Every engagement opens with a discovery call, content plan, channel map and posting cadence before we shoot anything. Strategy and planning are part of the scope on every proposal — not an upsell.',
  },
  {
    q: 'What does the production workflow look like, shoot to publish?',
    a: 'Multicam capture, edit, color, motion and copy — all in-house. You get a ready-to-publish file, or the post itself if we run your channels. No subcontractors, no handoffs, no broken cadence.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const serviceSchemas = services.map((service) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description: service.description,
  serviceType: service.title,
  provider: { '@id': 'https://captureandconnect.nl/#organization' },
  areaServed: [
    { '@type': 'Country', name: 'Netherlands' },
    { '@type': 'Country', name: 'Belgium' },
    { '@type': 'Country', name: 'Austria' },
  ],
  url: `https://captureandconnect.nl/services/#${service.id}`,
}));

const pageSchemas = [faqSchema, ...serviceSchemas];
---

<BaseLayout
  title="Content, Social Media & Web Design Services | Capture & Connect"
  fullTitle={true}
  description="Three services, one growth system: content creation, social media management and conversion-focused web design — for artists, festivals and brands in NL."
  ogImage="/og-services.jpg"
  jsonLd={pageSchemas}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Services', href: '/services/' },
  ]}
>

  <!-- Page Hero -->
  <section class="relative bg-[#020202] pt-32 pb-16 md:pt-40 md:pb-20 overflow-hidden">
    <div class="relative max-w-[1600px] mx-auto px-6 md:px-10 lg:px-14">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-10 items-end">
        <div class="md:col-span-8">
          <SectionLabel n={1} label="Services" marker="dot" class="mb-6" />
          <h1 class="text-[clamp(3.5rem,9vw,9rem)] font-black italic uppercase leading-[0.95] tracking-tighter text-white">
            Everything to <br/><span class="text-outline not-italic">grow.</span>
          </h1>
        </div>
        <p class="md:col-span-4 text-[15px] text-white/50 leading-relaxed">
          From content creation to social media to websites. One system, built for growth.
        </p>
      </div>
    </div>
  </section>

  <!-- Services -->
  <div>
    {services.map((service, index) => (
      <ServiceDetail
        service={service}
        reversed={index % 2 !== 0}
      />
    ))}
  </div>

  <!-- Who this is for / Not for -->
  <section class="relative bg-[#020202] py-20 md:py-24 border-t border-white/[0.05]">
    <div class="relative max-w-[1600px] mx-auto px-6 md:px-10 lg:px-14">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-10 mb-12 md:mb-14 items-end">
        <div class="md:col-span-7">
          <SectionLabel n={2} label="Fit check" class="mb-6" />
          <h2 class="text-[clamp(2.5rem,7vw,6rem)] font-black italic uppercase leading-[0.95] tracking-tighter text-white">
            Right <br/><span class="text-outline not-italic">fit?</span>
          </h2>
        </div>
        <p class="md:col-span-4 md:col-start-9 text-[15px] text-white/50 leading-relaxed">
          We do our best work with brands that want a partner, not a vendor. Read both sides before you book.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-white/[0.04] border border-white/[0.05]">
        <!-- Built for -->
        <div class="bg-[#020202] p-8 md:p-10 lg:p-12 flex flex-col gap-6">
          <div class="flex items-center justify-between">
            <span class="font-mono text-[10px] text-white uppercase tracking-[0.25em]">// BUILT FOR</span>
            <span class="w-2 h-2 rounded-full bg-white"></span>
          </div>
          <h3 class="text-3xl md:text-4xl font-black italic uppercase leading-[0.95] tracking-tighter text-white">
            Brands ready to <br/><span class="text-outline not-italic">grow.</span>
          </h3>
          <ul class="flex flex-col gap-0 mt-2">
            {[
              'Artists, festivals and event brands ready to scale beyond word-of-mouth',
              'Local businesses with a real product or service that converts when seen',
              'Founders who want one team handling content, socials and the website',
              'Brands committed to consistent posting for 3+ months, not a one-off post',
              'People who treat marketing as investment, not expense',
            ].map((b) => (
              <li class="flex items-start gap-4 py-3.5 border-t border-white/[0.06] text-[14px] text-white/75 leading-relaxed">
                <span class="font-mono text-[11px] text-white shrink-0 mt-0.5">+</span>
                <span>{b}</span>
              </li>
            ))}
            <li class="border-t border-white/[0.06]"></li>
          </ul>
        </div>

        <!-- Not for -->
        <div class="bg-[#020202] p-8 md:p-10 lg:p-12 flex flex-col gap-6">
          <div class="flex items-center justify-between">
            <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.25em]">// NOT FOR</span>
            <span class="w-2 h-2 rounded-full border border-white/30"></span>
          </div>
          <h3 class="text-3xl md:text-4xl font-black italic uppercase leading-[0.95] tracking-tighter text-white/85">
            Probably <br/><span class="text-outline not-italic">not us.</span>
          </h3>
          <ul class="flex flex-col gap-0 mt-2">
            {[
              'Anyone looking for the cheapest option (we are not it)',
              'Brands wanting one viral video and disappearing — growth needs cadence',
              'Clients who expect to micro-manage every shot and caption',
              'Projects with no clear goal, no audience, no offer',
              'Anything illegal, exploitative or off-brand for our roster',
            ].map((b) => (
              <li class="flex items-start gap-4 py-3.5 border-t border-white/[0.06] text-[14px] text-white/55 leading-relaxed">
                <span class="font-mono text-[11px] text-white/40 shrink-0 mt-0.5">−</span>
                <span>{b}</span>
              </li>
            ))}
            <li class="border-t border-white/[0.06]"></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Us — command-cell row -->
  <section class="relative bg-[#020202] py-20 md:py-24 border-t border-white/[0.05]">
    <div class="relative max-w-[1600px] mx-auto px-6 md:px-10 lg:px-14">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-10 mb-12 md:mb-14 items-end">
        <div class="md:col-span-7">
          <SectionLabel n={3} label="Why us" class="mb-6" />
          <h2 class="text-[clamp(2.5rem,7vw,6rem)] font-black italic uppercase leading-[0.95] tracking-tighter text-white">
            Built for <br/><span class="text-outline not-italic">results.</span>
          </h2>
        </div>
        <p class="md:col-span-4 md:col-start-9 text-[15px] text-white/50 leading-relaxed">
          One in-house team. One workflow. Three reasons artists and brands stay.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-white/[0.04] border border-white/[0.05]">
        {[
          { id: '01', title: 'One team',         body: 'One point of contact, one workflow, no agency layers. Ryan leads every project personally, with a trusted crew of specialists when the scale calls for it.' },
          { id: '02', title: 'Built for results', body: 'We focus on views, growth and revenue. Not vanity metrics, not slide-deck math.' },
          { id: '03', title: 'Proven in the field', body: 'Used by artists, events and brands across the Netherlands, Belgium and beyond. Real numbers, public proof.' },
        ].map((why) => (
          <div class="why-cell group bg-[#020202] hover:bg-[#070707] transition-colors duration-500 p-8 md:p-10 flex flex-col gap-5 min-h-[260px]">
            <div class="flex items-center justify-between">
              <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.25em]">
                {why.id} // ADVANTAGE
              </span>
              <span class="w-1.5 h-1.5 rounded-full bg-white/30 group-hover:bg-white transition-colors duration-500"></span>
            </div>
            <h3 class="text-3xl md:text-4xl font-black italic uppercase leading-[0.95] tracking-tighter text-white">
              {why.title}
            </h3>
            <div class="h-px w-12 bg-white/10 group-hover:w-full group-hover:bg-white/30 transition-all duration-700"></div>
            <p class="text-[14px] text-white/55 leading-relaxed">{why.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CtaBlock
    headline="Ready to grow your brand?"
    subtext="Book a free growth call. We'll map exactly how we'd scale you."
    buttonText={CTA_PRIMARY}
    sectionNumber={4}
  />

</BaseLayout>

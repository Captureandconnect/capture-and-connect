---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceDetail from '../components/sections/ServiceDetail.astro';
import CtaBlock from '../components/sections/CtaBlock.astro';
import { services } from '../data/services';
---

<BaseLayout
  title="Services"
  description="Event videography, content creation, social media management and custom web design for artists, festivals and brands. One team, one system, zero gaps."
  ogImage="/og-services.jpg"
>

  <!-- Page Hero -->
  <section class="relative bg-[#020202] pt-32 pb-16 md:pt-40 md:pb-20 overflow-hidden">
    <div class="relative max-w-[1600px] mx-auto px-6 md:px-10 lg:px-14">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-10 items-end">
        <div class="md:col-span-8">
          <span class="font-mono text-[11px] text-white/55 uppercase tracking-[0.25em] mb-6 flex items-center gap-3">
            <span class="relative w-2 h-2 bg-white rounded-full">
              <span class="absolute inset-0 bg-white rounded-full animate-ping opacity-30"></span>
            </span>
            002 // SERVICES
          </span>
          <h1 class="text-[clamp(3.5rem,9vw,9rem)] font-black italic uppercase leading-[0.87] tracking-tighter text-white">
            Everything<br/>to <span class="text-outline not-italic">grow.</span>
          </h1>
        </div>
        <p class="md:col-span-4 text-[15px] text-white/50 leading-relaxed">
          From filming events to editing viral content to managing socials and building websites. One team. One system. Zero gaps.
        </p>
      </div>
    </div>
  </section>

  <!-- Services -->
  <div>
    {services.map((service, index) => (
      <ServiceDetail
        service={service}
        reversed={index % 2 !== 0}
      />
    ))}
  </div>

  <!-- Why Us — command-cell row -->
  <section class="relative bg-[#020202] py-20 md:py-24 border-t border-white/[0.05]">
    <div class="relative max-w-[1600px] mx-auto px-6 md:px-10 lg:px-14">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-10 mb-12 md:mb-14 items-end">
        <div class="md:col-span-7">
          <span class="font-mono text-[11px] text-white/55 uppercase tracking-[0.25em] mb-6 flex items-center gap-3">
            <span class="inline-block w-8 h-px bg-white/30"></span>
            007 // WHY US
          </span>
          <h2 class="text-[clamp(2.5rem,7vw,6rem)] font-black italic uppercase leading-[0.87] tracking-tighter text-white">
            Built<br/>for <span class="text-outline not-italic">results.</span>
          </h2>
        </div>
        <p class="md:col-span-4 md:col-start-9 text-[15px] text-white/50 leading-relaxed">
          One in-house team. One workflow. Three reasons brands choose us.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-white/[0.04] border border-white/[0.05]">
        {[
          { id: '001', title: 'In-house team',     body: 'No freelancers, no delays. One team handles everything, from filming on location to the final post.' },
          { id: '002', title: 'Built for virality', body: 'We don’t just film and post. We craft cinematic content engineered for reach and real growth.' },
          { id: '003', title: 'Artist & event experts', body: 'From mainstages to club nights, we’ve filmed and grown the biggest names in the scene.' },
        ].map((why) => (
          <div class="why-cell group bg-[#020202] hover:bg-[#070707] transition-colors duration-500 p-8 md:p-10 flex flex-col gap-5 min-h-[260px]">
            <div class="flex items-center justify-between">
              <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.25em]">
                {why.id} // ADVANTAGE
              </span>
              <span class="w-1.5 h-1.5 rounded-full bg-white/30 group-hover:bg-white transition-colors duration-500"></span>
            </div>
            <h3 class="text-3xl md:text-4xl font-black italic uppercase leading-[0.95] tracking-tighter text-white">
              {why.title}
            </h3>
            <div class="h-px w-12 bg-white/10 group-hover:w-full group-hover:bg-white/30 transition-all duration-700"></div>
            <p class="text-[14px] text-white/55 leading-relaxed">{why.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CtaBlock
    headline="Deserve to be seen?"
    subtext="Book a free strategy call and see how we'd grow your brand."
    buttonText="Book a strategy call"
  />

</BaseLayout>

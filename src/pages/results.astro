---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBlock from '../components/sections/CtaBlock.astro';
import { publicProof, aggregateStats } from '../data/results';
import { portfolioImage } from '../lib/portfolioImages';
import SectionLabel from '../components/ui/SectionLabel.astro';
import { REPLY_PROMISE } from '../data/promises';
---

<BaseLayout
  title="Results"
  description="Real numbers, public sources. Viral moments, live aftermovies and shipped websites — every result verifiable."
  ogImage="/og-results.jpg"
>

  <!-- Page Hero -->
  <section class="relative bg-[#020202] pt-32 pb-16 md:pt-40 md:pb-20 overflow-hidden">
    <div class="relative max-w-[1600px] mx-auto px-6 md:px-10 lg:px-14">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-10 items-end">
        <div class="md:col-span-8">
          <SectionLabel n={1} label="Results" marker="dot" class="mb-6" />
          <h1 class="text-[clamp(3.5rem,9vw,9rem)] font-black italic uppercase leading-[0.95] tracking-tighter text-white">
            Real <br/><span class="text-outline not-italic">results.</span>
          </h1>
        </div>
        <p class="md:col-span-4 text-[15px] text-white/50 leading-relaxed">
          Every result you see is real and verifiable. No projections. No fake numbers.
        </p>
      </div>
    </div>
  </section>

  <!-- Aggregate Stats: 4-up bento, public-only -->
  <section class="relative bg-[#020202] py-10 md:py-12 border-t border-white/[0.05]">
    <div class="relative max-w-[1600px] mx-auto px-6 md:px-10 lg:px-14">
      <div class="grid grid-cols-2 lg:grid-cols-5 gap-px bg-white/[0.04] border border-white/[0.05]">
        {aggregateStats.map((stat, idx) => {
          const id = String(idx + 1).padStart(2, '0');
          // Cards with a public source are links; the one aggregate figure that
          // has no single source stays a plain cell rather than faking one.
          const Tag = stat.href ? 'a' : 'div';
          const linkProps = stat.href
            ? {
                href: stat.href,
                'aria-label': stat.linkLabel,
                ...(stat.external ? { target: '_blank', rel: 'noopener noreferrer' } : {}),
              }
            : {};
          return (
            <Tag
              {...linkProps}
              class="bg-[#020202] p-6 md:p-8 flex flex-col gap-4 min-h-[220px] hover:bg-[#070707] transition-colors duration-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-[#020202]"
            >
              <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.25em]">
                {id} // VERIFIABLE
              </span>
              <h3 class="text-4xl md:text-5xl font-black italic tracking-tighter text-white leading-none mt-auto">
                {stat.value}
              </h3>
              <span class="font-mono text-[10px] text-white uppercase tracking-[0.2em]">
                {stat.label}
              </span>
              <p class="text-[12px] text-white/55 leading-relaxed">{stat.note}</p>
            </Tag>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Public proof rows: each links to the live source -->
  <section class="relative bg-[#020202] py-20 md:py-24 border-t border-white/[0.05]">
    <div class="relative max-w-[1600px] mx-auto px-6 md:px-10 lg:px-14">

      <!-- Heading -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-10 mb-12 md:mb-14 items-end">
        <div class="md:col-span-7">
          <SectionLabel n={2} label="Open the link" class="mb-6" />
          <h2 class="text-[clamp(2.5rem,7vw,6rem)] font-black italic uppercase leading-[0.95] tracking-tighter text-white">
            Verify it <br/><span class="text-outline not-italic">yourself.</span>
          </h2>
        </div>
        <p class="md:col-span-4 md:col-start-9 text-[15px] text-white/50 leading-relaxed">
          Every card opens a public source — a reel, a YouTube upload or a live site. Nothing behind a login. No slide-deck math.
        </p>
      </div>

      <!-- Proof rows -->
      <div class="flex flex-col gap-4">
        {publicProof.map((p, idx) => {
          const id = String(idx + 1).padStart(2, '0');
          return (
            <a
              href={p.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group relative grid grid-cols-1 md:grid-cols-12 gap-0 overflow-hidden bg-[#0a0a0a] border border-white/[0.06] hover:border-white/25 transition-all duration-500"
              data-event="portfolio_tile_click"
              data-event-id={p.url}
              data-event-location="results_proof"
            >
              <span class="absolute top-0 left-0 h-px w-12 bg-white transition-all duration-700 group-hover:w-full z-20" aria-hidden="true"></span>

              <!-- Cover -->
              <div class="md:col-span-5 relative aspect-[16/10] md:aspect-auto md:min-h-[280px] overflow-hidden">
                <Picture
                  src={portfolioImage(p.thumbnail)}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  widths={[400, 800, 1200]}
                  sizes="(min-width: 768px) 42vw, 100vw"
                  formats={['avif', 'webp']}
                  class="absolute inset-0 w-full h-full object-cover scale-105 group-hover:scale-100 transition-transform duration-1000"
                />
                <div class="absolute inset-0 bg-gradient-to-t md:bg-gradient-to-r from-[#020202] via-[#020202]/60 to-transparent opacity-90"></div>
                <div class="absolute top-4 left-4">
                  <span class="font-mono text-[10px] text-white/70 uppercase tracking-[0.25em]">
                    {id} // {p.category.toUpperCase()}
                  </span>
                </div>
                <div class="absolute bottom-4 left-4 right-4 md:hidden">
                  <span class="font-mono text-[10px] text-white/70 uppercase tracking-[0.2em]">{p.client}</span>
                </div>
              </div>

              <!-- Body -->
              <div class="md:col-span-7 p-7 md:p-10 flex flex-col gap-5 justify-center">
                <span class="hidden md:block font-mono text-[10px] text-white/55 uppercase tracking-[0.25em]">
                  {p.client}
                </span>
                <h3 class="text-2xl md:text-[2.2rem] font-black italic uppercase leading-[0.95] tracking-tighter text-white">
                  {p.headline}
                </h3>
                <p class="text-[14px] md:text-[15px] text-white/65 leading-relaxed max-w-2xl">
                  {p.context}
                </p>
                <p class="text-[13px] text-white/50 leading-relaxed max-w-2xl">
                  {p.detail}
                </p>

                <div class="flex flex-wrap items-center gap-3 pt-3 border-t border-white/[0.06]">
                  <div class="flex items-center gap-3 mr-auto">
                    <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.2em]">
                      {p.proofLabel}
                    </span>
                    <span class="text-2xl font-black italic tracking-tighter text-white">{p.proofValue}</span>
                  </div>
                  <span class="inline-flex items-center gap-2 font-mono text-[11px] text-white uppercase tracking-[0.2em]">
                    Open source
                    <span class="w-9 h-9 rounded-full border border-white/15 flex items-center justify-center group-hover:bg-white transition-all duration-500">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" class="group-hover:stroke-black stroke-white/80 transition-colors duration-500">
                        <path d="M7 17L17 7M17 7H8M17 7V16" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </span>
                </div>
              </div>
            </a>
          );
        })}
      </div>

      <!-- Footnote -->
      <p class="mt-12 font-mono text-[11px] text-white/45 uppercase tracking-[0.2em] max-w-2xl">
        // No private dashboards. No projected numbers. If it's on this page, it lives on a public URL.
      </p>
    </div>
  </section>

  <CtaBlock
    headline="Want results like this?"
    subtext={`Tell us where you are. We'll show you exactly how we'd get you there. ${REPLY_PROMISE}`}
    buttonText="Book Your Call"
    sectionNumber={3}
  />

</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBlock from '../components/sections/CtaBlock.astro';
import { caseStudies, aggregateStats } from '../data/results';
---

<BaseLayout
  title="Results"
  description="Real results from real campaigns. See how Capture & Connect drove millions of views, viral moments, and measurable growth for artists, events and brands."
>

  <!-- Page Hero -->
  <section class="relative bg-[#020202] pt-32 pb-16 md:pt-40 md:pb-20 overflow-hidden">
    <div class="relative max-w-[1600px] mx-auto px-6 md:px-10 lg:px-14">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-10 items-end">
        <div class="md:col-span-8">
          <span class="font-mono text-[11px] text-white/40 uppercase tracking-[0.25em] mb-6 flex items-center gap-3">
            <span class="relative w-2 h-2 bg-white rounded-full">
              <span class="absolute inset-0 bg-white rounded-full animate-ping opacity-30"></span>
            </span>
            004 // RESULTS
          </span>
          <h1 class="text-[clamp(3.5rem,9vw,9rem)] font-black italic uppercase leading-[0.87] tracking-tighter text-white">
            Numbers don't<br/><span class="text-outline not-italic">lie.</span>
          </h1>
        </div>
        <p class="md:col-span-4 text-[15px] text-white/50 leading-relaxed">
          Real campaigns. Real numbers. Every figure reflects organic growth — no paid shortcuts, no inflated metrics.
        </p>
      </div>
    </div>
  </section>

  <!-- Aggregate Stats — 5-up bento -->
  <section class="relative bg-[#020202] py-10 md:py-12 border-t border-white/[0.05]">
    <div class="relative max-w-[1600px] mx-auto px-6 md:px-10 lg:px-14">
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-px bg-white/[0.04] border border-white/[0.05]">
        {aggregateStats.map((stat, idx) => {
          const id = String(idx + 1).padStart(3, '0');
          return (
            <div class="bg-[#020202] p-6 md:p-8 flex flex-col gap-4 min-h-[180px] hover:bg-[#070707] transition-colors duration-500">
              <span class="font-mono text-[10px] text-white/30 uppercase tracking-[0.25em]">
                {id} // METRIC
              </span>
              <h3 class="text-4xl md:text-5xl font-black italic tracking-tighter text-white leading-none mt-auto">
                {stat.value}
              </h3>
              <span class="font-mono text-[10px] text-white/40 uppercase tracking-[0.2em]">
                {stat.label}
              </span>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Case Studies as long monolithic rows -->
  <section class="relative bg-[#020202] py-20 md:py-24 border-t border-white/[0.05]">
    <div class="relative max-w-[1600px] mx-auto px-6 md:px-10 lg:px-14">

      <!-- Heading -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-10 mb-12 md:mb-14 items-end">
        <div class="md:col-span-7">
          <span class="font-mono text-[11px] text-white/40 uppercase tracking-[0.25em] mb-6 flex items-center gap-3">
            <span class="inline-block w-8 h-px bg-white/30"></span>
            005 // CASE STUDIES
          </span>
          <h2 class="text-[clamp(2.5rem,7vw,6rem)] font-black italic uppercase leading-[0.87] tracking-tighter text-white">
            Behind the<br/><span class="text-outline not-italic">numbers.</span>
          </h2>
        </div>
        <p class="md:col-span-4 md:col-start-9 text-[15px] text-white/50 leading-relaxed">
          Four projects, four different angles. Each one shipped, measured and grown organically.
        </p>
      </div>

      <!-- Case rows -->
      <div class="flex flex-col gap-4">
        {caseStudies.map((cs, idx) => {
          const id = String(idx + 1).padStart(3, '0');
          return (
            <article class="group glass-panel p-7 md:p-10 grid grid-cols-1 md:grid-cols-12 gap-8 transition-transform duration-500 hover:-translate-y-1">

              <div class="md:col-span-5 flex flex-col gap-5">
                <span class="font-mono text-[10px] text-white/30 uppercase tracking-[0.25em]">
                  {id} // {cs.category.toUpperCase()} · {cs.client.toUpperCase()}
                </span>
                <h3 class="text-3xl md:text-4xl font-black italic uppercase leading-[0.95] tracking-tighter text-white">
                  {cs.headline}
                </h3>
                <div class="flex flex-col gap-2 mt-2">
                  <span class="font-mono text-[10px] text-white/30 uppercase tracking-[0.2em]">PROBLEM</span>
                  <p class="text-[14px] text-white/55 leading-relaxed">{cs.problem}</p>
                </div>
                <div class="flex flex-col gap-2">
                  <span class="font-mono text-[10px] text-white/30 uppercase tracking-[0.2em]">APPROACH</span>
                  <p class="text-[14px] text-white/55 leading-relaxed">{cs.approach}</p>
                </div>
                <div class="flex flex-col gap-2">
                  <span class="font-mono text-[10px] text-white/30 uppercase tracking-[0.2em]">RESULT</span>
                  <p class="text-[14px] text-white/70 leading-relaxed">{cs.result}</p>
                </div>
              </div>

              <!-- Stats column -->
              <div class="md:col-span-7 grid grid-cols-2 gap-px bg-white/[0.04] border border-white/[0.05] self-start">
                {cs.stats.map((s, sIdx) => (
                  <div class="bg-[#020202] p-6 md:p-7 flex flex-col gap-3 min-h-[140px] hover:bg-[#0a0a0a] transition-colors duration-500">
                    <span class="font-mono text-[9px] text-white/30 uppercase tracking-[0.25em]">
                      0{sIdx + 1} · {s.label}
                    </span>
                    <h4 class="text-3xl md:text-4xl font-black italic tracking-tighter text-white leading-none mt-auto">
                      {s.value}
                    </h4>
                  </div>
                ))}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <CtaBlock
    headline="Want results like these?"
    subtext="Let's talk about what we can do for your brand."
    buttonText="Book a call"
  />

</BaseLayout>

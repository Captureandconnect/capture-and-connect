---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="That page doesn't exist. Head back to the homepage or browse the work."
  ogImage="/og-default.jpg"
>

  <section class="relative bg-[#020202] min-h-[100svh] flex items-center pt-32 pb-20 md:pt-40 md:pb-24 overflow-hidden">
    <div class="relative max-w-[1600px] mx-auto px-6 md:px-10 lg:px-14 w-full">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-12 items-end">

        <div class="md:col-span-8">
          <span class="font-mono text-[11px] text-white/55 uppercase tracking-[0.25em] mb-6 flex items-center gap-3">
            <span class="relative w-2 h-2 bg-white rounded-full"></span>
            ERR // 404
          </span>
          <h1 class="text-[clamp(3.5rem,9vw,9rem)] font-black italic uppercase leading-[0.87] tracking-tighter text-white">
            Wrong<br/><span class="text-outline not-italic">turn.</span>
          </h1>
        </div>

        <p class="md:col-span-4 text-[15px] text-white/50 leading-relaxed">
          The page you're looking for doesn't exist, moved, or was never here. Pick a direction below.
        </p>

      </div>

      <div class="mt-16 md:mt-20 grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
        <a href="/" class="glass-panel p-5 md:p-6 group block">
          <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.25em] block mb-3">// HOME</span>
          <span class="text-base md:text-lg font-black italic tracking-tight text-white group-hover:text-white/85 transition-colors">Start over</span>
        </a>
        <a href="/portfolio/" class="glass-panel p-5 md:p-6 group block">
          <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.25em] block mb-3">// WORK</span>
          <span class="text-base md:text-lg font-black italic tracking-tight text-white group-hover:text-white/85 transition-colors">See the work</span>
        </a>
        <a href="/services/" class="glass-panel p-5 md:p-6 group block">
          <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.25em] block mb-3">// SERVICES</span>
          <span class="text-base md:text-lg font-black italic tracking-tight text-white group-hover:text-white/85 transition-colors">What we do</span>
        </a>
        <a href="/contact/" class="glass-panel p-5 md:p-6 group block">
          <span class="font-mono text-[10px] text-white/55 uppercase tracking-[0.25em] block mb-3">// CONTACT</span>
          <span class="text-base md:text-lg font-black italic tracking-tight text-white group-hover:text-white/85 transition-colors">Book a call</span>
        </a>
      </div>

    </div>
  </section>

</BaseLayout>

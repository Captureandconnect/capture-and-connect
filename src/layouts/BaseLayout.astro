---
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/global/Nav.astro';
import Footer from '../components/global/Footer.astro';
import SoundToggle from '../components/global/SoundToggle.astro';
import CookieBanner from '../components/global/CookieBanner.astro';
import StickyMobileCta from '../components/global/StickyMobileCta.astro';

import '../styles/global.css';
import '../styles/animations.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** When true, render `title` as-is (used for keyword-led titles that already include the brand). */
  fullTitle?: boolean;
  /** Optional breadcrumb trail — emits BreadcrumbList JSON-LD automatically. */
  breadcrumbs?: { name: string; href: string }[];
  /** Override <html lang>. Defaults to 'en'. The /privacy/nl page sets 'nl'. */
  lang?: string;
}

const {
  title,
  description,
  ogImage = '/og-default.jpg',
  jsonLd,
  fullTitle = false,
  breadcrumbs,
  lang = 'en',
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://captureandconnect.nl');
const pageTitle = fullTitle ? title : `${title} | Capture & Connect`;
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Capture & Connect',
  url: 'https://captureandconnect.nl',
  logo: 'https://captureandconnect.nl/apple-touch-icon.png',
  email: 'info@captureandconnect.nl',
  founder: { '@type': 'Person', name: 'Ryan van der Niet' },
  sameAs: ['https://www.instagram.com/captureandconnect_'],
  address: { '@type': 'PostalAddress', addressCountry: 'NL' },
  vatID: 'NL004804916B78',
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Capture & Connect',
  url: 'https://captureandconnect.nl',
  inLanguage: 'en',
};

const pageSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0
  ? [{
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((crumb, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: crumb.name,
        item: new URL(crumb.href, 'https://captureandconnect.nl').toString(),
      })),
    }]
  : [];

const allSchemas = [organizationSchema, websiteSchema, ...breadcrumbSchema, ...pageSchemas];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, canonicalURL)} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, canonicalURL)} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Theme color + dark color-scheme to suppress white flash before CSS loads -->
    <meta name="theme-color" content="#020202" />
    <meta name="color-scheme" content="dark" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Inter Variable preload — stable filename, served from /public/fonts -->
    <!-- Both regular and italic preloaded: H1/H2 across the site use the italic variant. -->
    <link rel="preload" href="/fonts/inter-latin-wght.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/inter-latin-wght-italic.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

    <!-- Cross-page crossfade transitions (Astro 4+) -->
    <ClientRouter fallback="swap" />

    <!-- JSON-LD: Organization + WebSite + page-specific -->
    {allSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>

  <body class="bg-[#020202] text-white font-sans antialiased overflow-x-hidden">
    <!-- First-visit loader curtain (sessionStorage-gated, single tab session) -->
    <div id="cnc-loader" class="cnc-loader" aria-hidden="true" hidden>
      <div class="cnc-loader__mark">CAPTURE&amp;CONNECT</div>
      <div class="cnc-loader__bar"></div>
      <div class="cnc-loader__tag">Booting the studio</div>
    </div>
    <script is:inline>
      (() => {
        try {
          const seen = sessionStorage.getItem('cnc-seen');
          const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
          const saveData = navigator.connection && navigator.connection.saveData;
          // Skip the curtain for headless audits (Lighthouse, bots) — it's a
          // first-impression flourish, not content; auditors shouldn't pay for it.
          const isAuditor = /HeadlessChrome|Lighthouse|PageSpeed|GTmetrix|Speedlify/i.test(navigator.userAgent);
          const el = document.getElementById('cnc-loader');
          if (!el) return;
          if (seen || reduced || saveData || isAuditor) return;
          el.removeAttribute('hidden');
          sessionStorage.setItem('cnc-seen', '1');
          setTimeout(() => {
            el.dataset.state = 'hide';
            setTimeout(() => el.remove(), 500);
          }, 850);
        } catch (_) {}
      })();
    </script>

    <!-- Skip-to-main link, visible only on keyboard focus -->
    <a href="#main" class="skip-link">Skip to main content</a>

    <!-- Subtle global grain -->
    <div
      class="pointer-events-none fixed inset-0 z-[4] opacity-[0.04] mix-blend-overlay"
      style='background-image: url("data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22220%22 height=%22220%22><filter id=%22n%22><feTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%222%22 stitchTiles=%22stitch%22/></filter><rect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22/></svg>");'
      aria-hidden="true"
    ></div>

    <Nav transition:persist="cnc-nav" />
    <main id="main">
      <slot />
    </main>
    <Footer transition:persist="cnc-footer" />
    <SoundToggle transition:persist="cnc-sound" />
    <StickyMobileCta transition:persist="cnc-mobile-cta" />
    <CookieBanner transition:persist="cnc-cookie" />

    <!-- GSAP animations — deferred to browser idle so they never block LCP -->
    <script>
      const loadAnimations = () => import('../scripts/animations.ts');
      if ('requestIdleCallback' in window) {
        (window as any).requestIdleCallback(loadAnimations, { timeout: 2000 });
      } else {
        setTimeout(loadAnimations, 200);
      }
    </script>

    <!-- Click sounds — deferred idle load -->
    <script>
      const loadSound = () => import('../scripts/sound.ts');
      if ('requestIdleCallback' in window) {
        (window as any).requestIdleCallback(loadSound, { timeout: 2000 });
      } else {
        setTimeout(loadSound, 200);
      }
    </script>

    {cfBeaconToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${cfBeaconToken}"}`}
      />
    )}

    <script is:inline>
      if ('serviceWorker' in navigator && location.protocol === 'https:') {
        const reg = () => navigator.serviceWorker.register('/sw.js').catch(() => {});
        if ('requestIdleCallback' in window) {
          requestIdleCallback(reg, { timeout: 4000 });
        } else {
          window.addEventListener('load', () => setTimeout(reg, 1500));
        }
      }
    </script>

  </body>
</html>
